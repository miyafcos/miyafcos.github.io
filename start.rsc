18:["$","svg",null,{"className":"fig-narrow","viewBox":"0 0 350 380","width":"100%","role":"img","aria-label":"最初の 10 分の 6 手。作る、立てる、並べる、開く、残す、更新する","data-vw":350,"data-fs":15,"xmlns":"http://www.w3.org/2000/svg","children":[["$","title",null,{"children":"最初の 10 分の 6 手。作る、立てる、並べる、開く、残す、更新する"}],["$","defs",null,{"children":[["$","marker",null,{"id":"F9-narrow-arrow","viewBox":"0 0 10 10","refX":"9","refY":"5","markerWidth":"8","markerHeight":"8","orient":"auto-start-reverse","children":["$","path",null,{"d":"M0 0L10 5L0 10z","className":"arrowhead"}]}],["$","marker",null,{"id":"F9-narrow-arrow-accent","viewBox":"0 0 10 10","refX":"9","refY":"5","markerWidth":"8","markerHeight":"8","orient":"auto-start-reverse","children":["$","path",null,{"d":"M0 0L10 5L0 10z","className":"arrowhead accent"}]}]]}],[["$","g","0",{"children":[["$","path",null,{"d":"M165 50L185 50","className":"edge","markerEnd":"url(#F9-narrow-arrow)"}],"$undefined"]}],["$","g","1",{"children":[["$","path",null,{"d":"M267.5 100L267.5 120L82.5 120L82.5 140","className":"edge","markerEnd":"url(#F9-narrow-arrow)"}],"$undefined"]}],["$","g","2",{"children":[["$","path",null,{"d":"M165 190L185 190","className":"edge","markerEnd":"url(#F9-narrow-arrow)"}],"$undefined"]}],["$","g","3",{"children":[["$","path",null,{"d":"M267.5 240L267.5 260L82.5 260L82.5 280","className":"edge","markerEnd":"url(#F9-narrow-arrow)"}],"$undefined"]}],["$","g","4",{"children":[["$","path",null,{"d":"M165 330L185 330","className":"edge","markerEnd":"url(#F9-narrow-arrow)"}],"$undefined"]}]],[["$","g","1",{"className":"node n-box","data-w":165,"data-id":"1","children":[["$","rect",null,{"x":0,"y":0,"width":165,"height":100,"rx":8}],["$","text",null,{"x":82.5,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":82.5,"y":32.25,"className":"title","children":"1 作る"}],["$","tspan","1",{"x":82.5,"y":55.25,"className":"sub","children":"Ctrl+Shift+N"}],["$","tspan","2",{"x":82.5,"y":78.25,"className":"sub","children":"ワークスペース"}]]}]]}],["$","g","2",{"className":"node n-box","data-w":165,"data-id":"2","children":[["$","rect",null,{"x":185,"y":0,"width":165,"height":100,"rx":8}],["$","text",null,{"x":267.5,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":267.5,"y":32.25,"className":"title","children":"2 立てる"}],["$","tspan","1",{"x":267.5,"y":55.25,"className":"sub","children":"Claude Code"}],["$","tspan","2",{"x":267.5,"y":78.25,"className":"sub","children":"をクリック"}]]}]]}],["$","g","3",{"className":"node n-box","data-w":165,"data-id":"3","children":[["$","rect",null,{"x":0,"y":140,"width":165,"height":100,"rx":8}],["$","text",null,{"x":82.5,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":82.5,"y":172.25,"className":"title","children":"3 並べる"}],["$","tspan","1",{"x":82.5,"y":195.25,"className":"sub","children":"Ctrl+Alt+D"}],["$","tspan","2",{"x":82.5,"y":218.25,"className":"sub","children":"Codex を起動"}]]}]]}],["$","g","4",{"className":"node n-box","data-w":165,"data-id":"4","children":[["$","rect",null,{"x":185,"y":140,"width":165,"height":100,"rx":8}],["$","text",null,{"x":267.5,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":267.5,"y":172.25,"className":"title","children":"4 開く"}],["$","tspan","1",{"x":267.5,"y":195.25,"className":"sub","children":"パスを"}],["$","tspan","2",{"x":267.5,"y":218.25,"className":"sub","children":"クリック"}]]}]]}],["$","g","5",{"className":"node n-box","data-w":165,"data-id":"5","children":[["$","rect",null,{"x":0,"y":280,"width":165,"height":100,"rx":8}],["$","text",null,{"x":82.5,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":82.5,"y":312.25,"className":"title","children":"5 残す"}],["$","tspan","1",{"x":82.5,"y":335.25,"className":"sub","children":"セーブポイント"}],["$","tspan","2",{"x":82.5,"y":358.25,"className":"sub","children":"を作成"}]]}]]}],["$","g","6",{"className":"node n-box","data-w":165,"data-id":"6","children":[["$","rect",null,{"x":185,"y":280,"width":165,"height":100,"