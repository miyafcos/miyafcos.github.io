":"Cmd"}]]}],["$","span","1",{"children":[["$","span",null,{"className":"key-join","children":"+"}],["$","kbd",null,{"children":"D"}]]}]]}]}]]}],["$","tr","下にタブを開く",{"children":[["$","td",null,{"data-label":"したいこと","children":"下にタブを開く"}],["$","td",null,{"data-label":"Windows","children":["$","span",null,{"className":"keys","children":[["$","span","0",{"children":[false,["$","kbd",null,{"children":"Ctrl"}]]}],["$","span","1",{"children":[["$","span",null,{"className":"key-join","children":"+"}],["$","kbd",null,{"children":"Alt"}]]}],["$","span","2",{"children":[["$","span",null,{"className":"key-join","children":"+"}],["$","kbd",null,{"children":"Shift"}]]}],["$","span","3",{"children":[["$","span",null,{"className":"key-join","children":"+"}],["$","kbd",null,{"children":"D"}]]}]]}]}],["$","td",null,{"data-label":"Mac","children":["$","span",null,{"className":"keys","children":[["$","span","0",{"children":[false,["$","kbd",null,{"children":"Shift"}]]}],["$","span","1",{"children":[["$","span",null,{"className":"key-join","children":"+"}],["$","kbd",null,{"children":"Cmd"}]]}],["$","span","2",{"children":[["$","span",null,{"className":"key-join","children":"+"}],["$","kbd",null,{"children":"D"}]]}]]}]}]]}]]}]]}]]}]
22:["$","figcaption",null,{"children":[["$","span",null,{"className":"fig-no","children":"図 1"}],"ワークスペース内のタブを、表示場所ごとに並べて切り替えます。ワークスペースは別ウィンドウへ切り出せます。"]}]
2f:T6f2,<h3 id="workspace-create">ワークスペースを作る<a class="heading-anchor" href="#workspace-create" aria-label="この節へのリンク">#</a></h3>
<table class="two-column-table">
<thead>
<tr><th>したいこと</th><th>操作</th></tr></thead>
<tbody>
<tr><td data-label="したいこと">すぐに作る</td><td data-label="操作"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>N</kbd></span>。現在の作業フォルダを引き継ぎます。</td></tr>
<tr><td data-label="したいこと">エージェントや配置も選ぶ</td><td data-label="操作"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>N</kbd></span></td>
</tr>
<tr><td data-label="したいこと">次の作業場へ移る</td><td data-label="操作"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Tab</kbd></span>。前へ戻るときは <kbd>Shift</kbd> も押します。</td></tr></tbody></table><p>Mac で作るときは、<kbd>Ctrl</kbd> を <kbd>Cmd</kbd> に読み替えます。切り替えは、両方の OS で <span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Tab</kbd></span> です。</p><p>サイドバーの行をダブルクリックすると、ワークスペース名を変えられます。行の「⋮」では色の変更と「新しいウィンドウで開く」を選べます。行をドラッグすると並び順が変わります。</p><p>色は 8 色と色なしから選べます。サイドバーの幅は、境界をドラッグして 200〜560px に変えられます。作成時の配置は 8 種類で、既定は 3×1 です。</p>23:["$","div","2",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$2f"}}]]}]
24:["$","details","3",{"className":"guide-details","children":[["$","summary",null,{"id":"workspace-1","children":"番号でワークスペースへ移る"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>Windows は <kbd>Ctrl</kbd>、Mac は <kbd>Cmd</kbd> と 1〜8 の数字キーを押します。9 を押すと、最後のワークスペースへ移ります。</p>"}}]]}]]}]]}]
30:Tbe8,<p>見出しには、表示中のタブの名前と「裏 N」が出ます。狭いときは「+N」になり、押すと同じ場所のタブ一覧が開きます。一覧でタブを選び、名前の変更、並びの先頭への固定、終了もできます。</p>
<table class="two-column-table">
<thead>
<tr><th>したいこと</th><th>操作</th></tr></thead>
<tbody>
<tr><td data-label="したいこと">同じ場所にタブを足す</td><td data-label="操作">見出しの「⋮」から「新しいターミナルタブ」を選びます。</td></tr>
<tr><td data-label="したいこと">裏のタブへ切り替える</td><td data-label="操作">「裏 N」を押して、一覧から選びます。</td></tr>
<tr><td data-label="したいこと">右や下に並べる</td><td data-label="操作">見出しの「右にタブを開く」を押します。下に開く操作と、狭い表示では「⋮」から選びます。</td></tr>
<tr><td data-label="したいこと">ひとつに集中する</td><td data-label="操作"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>Enter</kbd></span>。もう一度押すと元へ戻ります。</td></tr>
<tr><td data-label="したいこと">表示中のタブを閉じる</td><td data-label="操作">名前のすぐ右の「×」か <span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>W</kbd></span></td>
</tr>
<tr><td data-label="したいこと">閉じたタブを開き直す</td><td data-label="操作"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>T</kbd></span></td>
</tr>
</tbody>
</table><p>右に開くキーは、Windows では <span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>D</kbd></span> です。Mac では <span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>D</kbd></span> です。<kbd>Shift</kbd> も押すと、下に開きます。</p><p>見出しの分割ボタンは、既定では「右にタブを開く」だけが出ます。「設定 → 通知・配置・入力」で「下にタブを開く」も表示できます。「このタブだけ表示」の最中に分割すると、拡大を解いて新しいタブを見せます。</p><p>名前のすぐ右の「×」は、表示中のタブだけを閉じ、裏のタブは残します。</p><p>見出しの右端の「×」は、裏のタブも含めて同じ表示場所を閉じます。右端の「×」は裏のタブがあるときだけ出て、狭い表示では出ません。狭いときは「⋮」の「このタブと裏のタブ N 個を閉じる」を使います。この操作で開き直せるのは、表示中だった 1 つだけです。</p><p>作業中のタブには、閉じる前に確認が出ます。最後の表示場所を空にする操作は、理由を示して押せなくなります。</p>25:["$","section","pane-handles",{"id":"pane-handles","children":[["$","h2",null,{"children":["タブを並べ、切り替えたい",["$","a",null,{"className":"heading-anchor","href":"#pane-handles","aria-label":"この節へのリンク","children":"#"}]]}],[],["$","nav",null,{"className":"section-jumps","aria-label":"タブを並べ、切り替えたいの小見出し","children":[["$","a","workspace-size",{"href":"#workspace-size","children":"大きさと境界を変える"}],["$","a","workspace-6",{"href":"#workspace-6","children":"名前、固定と狭い表示"}],["$","a","pane-names",{"href":"#pane-names","children":"タブの名前が付くしくみ"}],["$","a","tab-focus",{"href":"#tab-focus","children":"マウスを乗せて入力先を変える"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$30"}}]]}],["$","details","1",{"className":"guide-details","children":[["$","summary",null,{"id":"workspace-size","children":"大きさと境界を変える"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>境界線をドラッグすると、表示場所の幅や高さを変えられます。手で動かした線だけが位置を覚えます。別の場所を分割しても、手で広げた幅は変わりません。</p><p>境界線をダブルクリックすると、同じ並びを均等に戻せます。「このタブだけ表示」で拡大しても、裏の作業は続きます。</p>"}}]]}]]}]]}],["$","details","2",{"className":"guide-details","children":[["$","summary",null,{"id":"workspace-6","children":"名前、固定と狭い表示"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>名前の変更は「⋮」かタブ一覧から行います。「名前を自動に戻す」で、自動命名へ戻せます。<span class=\"keys\"><kbd>Ctrl</kbd><span class=\"key-join\">+</span><kbd>Alt</kbd><span class=\"key-join\">+</span><kbd>P</kbd></span> で、表示中のタブを並びの先頭に固定します。</p><p>細い表示でも「×」と「⋮」は残ります。裏のタブのエラーや返事待ちは、「裏 N」の色でも分かります。</p>"}}]]}]]}]]}],["$","details","3",{"className":"guide-details","children":[["$","summary",null,{"id":"pane-names","children":"タブの名前が付くしくみ"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>Claude Code では会話の題名を使い、手で付けた題名があればそちらを優先します。題名がないタブは、指示から分かる作業名、それもなければ起動時の名前を使います。材料がなければ「作業内容未取得」と、取れない理由を短く表示します。</p><p>自分で付けた名前は変えません。命名に AI のモデルは使いません。</p><p>名前は 20 字までで、同じ名前が並ぶときだけ番号を添えます。題名の頭が、手で付けたワークスペース名と同じなら、その部分を省きます。ワークスペースの自動名には、会話の題名と指示からの名前を使い、起動時の名前は数えません。</p><p>材料を一時的に読めなくなったら、最後の名前を「前回」の印つきで約 30 分残します。別のタブの名前を拾わないよう、そのタブのものと確認できた材料だけを使います。依頼を中断したり別の依頼に替えたりした後は、前の作業名を使いません。「続けて」など、続きだと確認できる入力では名前を保ちます。</p><p>「設定 → AI」で自動命名を切り替えられます。</p>"}}]]}]]}]]}],"$L31"]]}]
32:Tb84,<p>ダッシュボードの配置図から「タブ再配置」を開きます。配置を確認して適用でき、適用後は「元に戻す」で取り消せます。</p>
<table class="two-column-table">
<thead>
<tr><th>切り口</th><th>まとめ方</th></tr></thead>
<tbody>
<tr><td data-label="切り口">「今の場所に寄せる」</td><td data-label="まとめ方">移動を抑えます。</td></tr>
<tr><td data-label="切り口">「案件ごとに分ける」</td><td data-label="まとめ方">同じ案件の作業をまとめます。</td></tr>
<tr><td data-label="切り口">「役割で見渡す」</td><td data-label="まとめ方">作業の役割で分けます。</td></tr>
<tr><td data-label="切り口">「稼働中だけ」</td><td data-label="まとめ方">見張る必要があるタブを集めます。</td></tr>
<tr><td data-label="切り口">「メインだけ」</td><td data-label="まとめ方">主に相手にしている最大 3 本を集めます。</td></tr>
<tr><td data-label="切り口">「属性でまとめる」</td><td data-label="まとめ方">案件を基本に、タブの少ない似た案件をまとめます。</td></tr></tbody></table><p>AI の案を待たず、内容を確かめて適用できます。「稼働中だけ」「メインだけ」は、同名のワークスペースがあればそこへまとめます。選んだ切り口を覚え、同名のワークスペースを増やしません。</p><p>「属性でまとめる」は、タブの少ない案件を、近い属性どうし 2〜3 件でまとめます。属性は「編集・制作」「アプリ・開発」「整理・事務」です。AI がオフでも、登録情報から案件を確定できるタブで案を作ります。</p><p>判定できない案件を推測でまとめず、名前も変えません。初めのプリセットは従来どおりで、「属性でまとめる」は選んだときに使います。</p><p>AI に役割の判定を補わせる Jev は、既定ではオフです。設定と送る情報は、<a href="/guide/settings#jev">Jev の説明</a>にまとめています。</p><p>閉じる候補は「タブ掃除」で、名前、判定、理由を確認します。キャンセルすると閉じず、AI が使えない場合も終了済みの候補を確認できます。休止はプロセスを終える操作で、途中の実行状態は戻りません。</p><p>休止候補は、作業中、権限待ち、質問待ちを保護します。完了だけが未読なら、会話の保存を確認してから休止できます。ただし休止候補と「稼働中だけ」は、ダッシュボードの新しい作業中判定とは別です。</p><p>長い道具や見張りが動く裏のタブも、休止時間が来ると止まる場合があります。自動休止を使う前に、<a href="/guide/settings#automation">休止の設定</a>を確かめてください。</p>26:["$","section","reflow",{"id":"reflow","children":[["$","h2",null,{"children":["タブをまとめ直したい",["$","a",null,{"className":"heading-anchor","href":"#reflow","aria-label":"この節へのリンク","children":"#"}]]}],[],false,[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$32"}}]]}]]]}]
27:["$","section","detach",{"id":"detach","children":[["$","h2",null,{"children":["タブを窓に切り離したい",["$","a",null,{"className":"heading-anchor","href":"#detach","aria-label":"この節へのリンク","children":"#"}]]}],[],["$","nav",null,{"className":"section-jumps","aria-label":"タブを窓に切り離したいの小見出し","children":[["$","a","detach-1",{"href":"#detach-1","children":"窓にして、戻す"}],["$","a","pane-drag-marks",{"href":"#pane-drag-marks","children":"戻す場所と目印"}],["$","a","detach-2",{"href":"#detach-2","children":"切り離した窓の帯を操作する"}],["$","a","detach-3",{"href":"#detach-3","children":"しおりから引き継ぐ"}],["$","a","detach-recovery",{"href":"#detach-recovery","children":"うまく戻らなかったとき"}],["$","a","detach-restart",{"href":"#detach-restart","children":"再起動のあと"}],["$","a","detach-settings",{"href":"#detach-settings","children":"切り離しの動きを設定する"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>タブの見出しを外へ引くと、その場で窓になり、押したままカーソルについてきます。端末は起動し直さず、作業を続けたまま移ります。Windows と Mac の両方で、この動きが既定です。</p><p>画面の倍率が違う場合や画面をまたぐ場合に、つかんだ位置と窓がずれる問題を修正しています。</p><h3 id=\"detach-1\">窓にして、戻す<a class=\"heading-anchor\" href=\"#detach-1\" aria-label=\"この節へのリンク\">#</a></h3>\n<ol><li>タブの見出しをつかみ、表示場所の外へ引きます。</li><li>好きな位置で離します。アプリの窓の上でも、いったん別の窓になります。</li><li>戻すときは窓の帯をつかみ、mycmux に重ねます。</li><li>入る位置の枠や破線を確かめて離します。<kbd>Esc</kbd> で移動前へ戻せます。</li></ol><p>見出しの空いた所をつかむと、裏のタブごと運べます。ワークスペースごと運ぶときは、サイドバーの行をつかみます。端末、HTML、Office、PDF、Web と、未起動のタブも対象です。</p>"}}]]}],["$","details","1",{"className":"guide-details","children":[["$","summary",null,{"id":"pane-drag-marks","children":"戻す場所と目印"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<table class=\"two-column-table\">\n<thead>\n<tr><th>離す場所</th><th>結果</th></tr></thead>\n<tbody>\n<tr><td data-label=\"離す場所\">表示場所の見出し</td><td data-label=\"結果\">同じ場所に加わり、そのタブを表示します。</td></tr>\n<tr><td data-label=\"離す場所\">表示場所の端</td><td data-label=\"結果\">分割して隣に並べます。</td></tr>\n<tr><td data-label=\"離す場所\">サイドバーのワークスペース名</td><td data-label=\"結果\">約 0.35 秒留まると、その作業場が開きます。</td></tr>\n<tr><td data-label=\"離す場所\">表示場所の中央</td><td data-label=\"結果\">タブとして合流し、落としたタブを表示します。先頭に固定したタブの並びは保ちます。</td></tr>\n<tr><td data-label=\"離す場所\">サイドバーの新規作成部分</td><td data-label=\"結果\">新しいワークスペースとして置きます。</td></tr></tbody></table><p>ほかの mycmux の窓にも戻せます。受け皿だけの窓は、サイドバーの「新しいウィンドウ」から開きます。要求が始まる前に断られた場合は、黄色の案内で知らせます。</p>"}}]]}]]}]]}],["$","div","2",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<h3 id=\"detach-2\">切り離した窓の帯を操作する<a class=\"heading-anchor\" href=\"#detach-2\" aria-label=\"この節へのリンク\">#</a></h3>\n<table>\n<thead>\n<tr><th>操作</th><th>Windows</th> <th>Mac</th>\n</tr>\n</thead>\n<tbody>\n<tr><td data-label=\"操作\">最小化</td><td data-label=\"Windows\">帯のボタンで畳みます。</td><td data-label=\"Mac\">新しい切り離しの帯にはありません。</td></tr>\n<tr><td data-label=\"操作\">最大化と元に戻す</td><td data-label=\"Windows\">ボタンか帯のダブルクリックです。</td><td data-label=\"Mac\">新しい切り離しの帯にはありません。</td></tr>\n<tr><td data-label=\"操作\">閉じる</td><td data-label=\"Windows\">窓のタブを終了します。作業中なら確認が出ます。</td><td data-label=\"Mac\">同じく、窓のタブを終了します。</td></tr></tbody></table><p>Windows 11 では、最大化ボタンに乗せると OS の配置候補が出ます。閉じる操作は作業を終了するため、戻すときは帯をつかんで運びます。</p><h3 id=\"detach-3\">しおりから引き継ぐ<a class=\"heading-anchor\" href=\"#detach-3\" aria-label=\"この節へのリンク\">#</a></h3><p>文脈を別のエージェントへ渡すときは、しおりと、しおりからのドラッグを使います。タブや窓を表示場所の中央に落としたときは、引き継ぎを出さずタブとして合流します。</p>"}}]]}],["$","details","3",{"className":"guide-details","children":[["$","summary",null,{"id":"detach-recovery","children":"うまく戻らなかったとき"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>通知の「付け直しをやり直す」から、端末表示の回復を確かめます。「切り離しをやり直す」が出た場合は、戻せてから再試行できます。通知に出たタブ名と場所を確かめてください。</p>"}}]]}]]}]]}],["$","details","4",{"className":"guide-details","children":["$L33","$L34"]}],"$L35"]]}]
28:["$","section","titlebar",{"id":"titlebar","children":[["$","h2",null,{"children":["タイトルバーの入口を知りたい",["$","a",null,{"className":"heading-anchor","href":"#titlebar","aria-label":"この節へのリンク","children":"#"}]]}],[],false,[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>左側には、サイドバーの開閉、セーブポイント一覧、ワークスペース作成の入口があります。中央はワークスペース名です。右側は次の 4 つで、Windows ではさらに窓の操作が並びます。</p>\n<table class=\"two-column-table\">\n<thead>\n<tr><th>入口</th><th>開くもの</th></tr></thead>\n<tbody>\n<tr><td data-label=\"入口\">「アカウントと使用量」</td><td data-label=\"開くもの\">アカウント一覧と使用量です。</td></tr>\n<tr><td data-label=\"入口\">「エージェント設計」</td><td data-label=\"開くもの\">設定、指示、記憶やスキルを読む画面です。</td></tr>\n<tr><td data-label=\"入口\">「ダッシュボード」</td><td data-label=\"開くもの\">全ワークスペースの会話と状態です。</td></tr>\n<tr><td data-label=\"入口\">「設定」</td><td data-label=\"開くもの\">アプリの設定です。</td></tr></tbody></table><p>上の帯に受け取り箱のボタンはありません。外部報告は、届いた通知の「開く」から確認します。</p><p>AI ログ分析とスキルは、エージェント設計の中から開きます。AI ログは「ふりかえり」を選んだときに読み込みます。使用量の帯の「CC」「CX」「GK」は、Claude Code、Codex、Grok Build です。</p>"}}]]}]]]}]
36:Tb25,<p>新しいタブに出る起動メニューが<strong>ランチャー</strong>です。「新規に起動」「Web」「開発」「案件」が並び、履歴があれば「続きから」も出ます。項目をクリックするか、検索欄に名前を打って選びます。</p><p>対応するエージェントは 8 種です。「Claude Code」「Codex」「claude-codex」「Grok」「agy」に対応します。「Hermes」「Oh My Pi」「Cursor」も選べます。表示する項目は「設定 → 作業 → 使うサービス」で選べます。</p><p>「Grok」は Grok Build を、「agy」は Antigravity の CLI です。</p><p>Claude Code、Codex、Grok は、ランチャーや新しいワークスペースの「アカウント」でタブごとに選べます。指定したアカウントは、アプリ再起動後の復元にも使われます。使えない場合は別のアカウントへ勝手に切り替えず、理由を示します。</p><p>未登録のものも「タブでも使う」から、その場で登録を始められます。タブの名札と ⋮ の「このタブのアカウント」で確認状態や使用量を見られます。</p><p>claude-codex のモデルは、この 1 行から選びます。</p><p>claude-codex から新しく起動したタブは、青い Claude Codex の印で見分けられます。</p><p>導入済みの Grok Bot を開く「Grok Bot (アプリ)」の入口もあります。</p><p>Claude Code、Codex、claude-codex、Grok Build の 4 種は、ランチャーと状態の表示で同じ扱いです。agy、Hermes、Oh My Pi は新規起動できますが、会話の再開や引き継ぎには対応しません。</p><p>Cursor は <code>cursor-agent</code> を別に入れ、「Cursor」から起動します。「…」で Composer 2.5 などのモデルを選べます。Cursor に独立した effort の項目はありません。会話の復元には対応せず、mycmux を再起動すると起動メニューに戻ります。</p><p>キーボードでは <kbd>↑</kbd><kbd>↓</kbd> で選び、<kbd>Enter</kbd> で決めます。<kbd>Esc</kbd> は検索語を消します。エージェントを選んで <kbd>Tab</kbd> か <span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Enter</kbd></span> を押すと、モデル選択へ進みます。</p><h3 id="launch-1">モデルと effort を選ぶ<a class="heading-anchor" href="#launch-1" aria-label="この節へのリンク">#</a></h3>
<p><strong>effort</strong> は、考える深さを指定する設定です。「モデル」「effort」を選び、「起動」を押します。<kbd>←</kbd><kbd>→</kbd> で値を変え、<kbd>↑</kbd><kbd>↓</kbd> か <kbd>Tab</kbd> で項目を移ります。</p><p>「既定」のままなら、CLI の既定値で起動します。</p>29:["$","section","launch",{"id":"launch","children":[["$","h2",null,{"children":["エージェントを起動したい",["$","a",null,{"className":"heading-anchor","href":"#launch","aria-label":"この節へのリンク","children":"#"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<div class=\"section-summary\"><p aria-level=\"3\" role=\"heading\"><strong>要点</strong></p>\n<ul><li>新しいタブのランチャーで、エージェントのアイコンを選びます。</li><li>「…」からモデルと effort（考える深さ）を選んで起動します。</li><li>Web のサービスや登録フォルダ、過去の会話からも始められます。</li></ul></div>"}}]]}]],["$","nav",null,{"className":"section-jumps","aria-label":"エージェントを起動したいの小見出し","children":[["$","a","launch-1",{"href":"#launch-1","children":"モデルと effort を選ぶ"}],["$","a","launch-terminal",{"href":"#launch-terminal","children":"普通のターミナルから始める"}],["$","a","web",{"href":"#web","children":"Web サービスを横に置く"}],["$","a","folders",{"href":"#folders","children":"開発や案件のフォルダを登録する"}],["$","a","continue",{"href":"#continue","children":"過去の続きから開く"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$36"}}]]}],["$","$L37","1",{"entry":{"id":"launch","theme":"dark","role":"detail","os":"windows","file":"/media/launch-dark-6739264d3bb2-crop-f956002f-160w.webp","srcSet":"/media/launch-dark-6739264d3bb2-crop-f956002f-160w.webp 160w, /media/launch-dark-6739264d3bb2-crop-f956002f-400w.webp 400w, /media/launch-dark-6739264d3bb2-crop-f956002f-496w.webp 496w, /media/launch-dark-6739264d3bb2-crop-f956002f-768w.webp 768w, /media/launch-dark-6739264d3bb2-crop-f956002f-992w.webp 992w","original":"/media/originals/launch-dark-6739264d3bb2-crop-f956002f.png","width":992,"height":987,"cssWidth":496,"appFontPx":11,"terminalFontPx":14,"uiFontScale":1,"geometryOk":true,"maxDisplayHeight":640,"readableWidth":496,"caption":"ランチャーで Antigravity のモデルと effort（考える深さ）の選択を開いています。「新規に起動」と「Web」の項目も見えます。","alt":"ランチャーの上に Antigravity のモデルと effort の選択肢、下に起動用のアイコンと Web の項目が出ている画面。","sample":false,"composite":false,"hotspots":[],"fallback":false,"assets":[{"file":"/media/launch-dark-6739264d3bb2-crop-f956002f-160w.webp","width":160,"height":159,"bytes":2528,"sha256":"609dd9f8974132b2bb3fbb34382ac01dab56ea50fa548a8adb2a88a7357d8b59"},{"file":"/media/launch-dark-6739264d3bb2-crop-f956002f-400w.webp","width":400,"height":398,"bytes":11044,"sha256":"dd30475b2c3cfa1910b7a95193111ea338555cfe354b7d1ecafb0b9324bb7484"},{"file":"/media/launch-dark-6739264d3bb2-crop-f956002f-496w.webp","width":496,"height":494,"bytes":15930,"sha256":"339d419e8acbbe71fe0695d807fd12de6d7aec20e2c5d62ae0781f920520f65f"},{"file":"/media/launch-dark-6739264d3bb2-crop-f956002f-768w.webp","width":768,"height":764,"bytes":30484,"sha256":"27ad88ffbbaa78efdd5be41cdd233a7415956858104741f3509803945822aac5"},{"file":"/media/launch-dark-6739264d3bb2-crop-f956002f-992w.webp","width":992,"height":987,"bytes":42964,"sha256":"9b9436df22151d91f93d78d1b8c3f9fb65449f528d4de04bfb83788b79685321"}],"captureGeneration":"earlier native demo"},"sizes":"(max-width: 767px) 92vw, 720px"}],"$L38","$L39","$L3a"]]}]
3b:T140c,<p>端末の出力から、成果物を開く、送った指示へ戻る、文字を探す、長い指示を書く操作です。</p><p>端末の表示履歴は 5,000 行です。プロセスが終了すると、終了を示す文字と再起動ボタンが出ます。出力はディスクにも保存します。</p><p>終了済みのセッションは保存済みの出力を、生きているセッションは現在の出力を取り直して表示します。</p><h3 id="conversation-view">会話の表示と端末の表示<a class="heading-anchor" href="#conversation-view" aria-label="この節へのリンク">#</a></h3><p>エージェントのタブは、見出しのアイコンから「会話の表示」と「端末の表示」を切り替えられます。既定は会話の表示で、設定の「通知・配置・入力」で端末の表示にも変えられます。</p><p>会話の表示の下には端末の最新行が出ます。Claude Code と Codex は会話内を検索できます。</p><p>Claude の入力欄では <code>/</code> から候補を選べます。会話履歴は「⋮」から開き、端末の表示に切り替わります。<span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>P</kbd></span> はセッションを続きから開くキーで、このタブの会話履歴を開く操作とは別です。</p><h3 id="pathlink">ファイルパスを開く<a class="heading-anchor" href="#pathlink" aria-label="この節へのリンク">#</a></h3><p>出力の中にある実在するファイルやフォルダは、そのままリンクです。日本語や空白を含むパスも、途中で折り返されたパスも対象です。クリックすると、対応する文書はプレビューで開き、それ以外は開き方を選べます。</p><h3 id="turnchip">送った指示まで戻る<a class="heading-anchor" href="#turnchip" aria-label="この節へのリンク">#</a></h3><p>端末の出力を遡ると、指示の位置へ戻る<strong>ターンチップ</strong>が出ます。「▲」「▼」で前後の指示へ移れます。指示の一覧は新しい順で最大 200 件です。</p><h3 id="conversation-history">会話の全過去を読む<a class="heading-anchor" href="#conversation-history" aria-label="この節へのリンク">#</a></h3>
<p>Claude Code と Codex は、会話の記録から作った履歴画面で読めます。端末の表示で上へホイールを回すか、「⋮」の「会話履歴を開く」から開きます。「最初へ」「最新へ」と、前後の指示へ移るボタンが使えます。</p><p>会話の全過去は、ページごとに読み込みます。検索は新しい発言から探し、「次へ」で古い方へ進みます。1,000 件に達すると数えるのを止め、「1,000 件以上」と表示します。</p><p>数えている途中は「ここまでで N 件」です。「止める」で止め、「もう一度検索」で追加された発言も探せます。長い本文の続きと、道具の呼び出しや出力は検索の対象外です。</p><p>日本語の変換中は検索せず、確定の <kbd>Enter</kbd> で次へ進みません。検索欄に打った文字は端末に入らず、閉じると端末へ戻れます。</p><p>会話の表示では検索操作が会話内を探し、端末の表示では端末内を探します。Grok の会話の表示では、端末の表示に切り替えてから端末内を検索します。「設定 → 通知・配置・入力」で、履歴への入り方を変えられます。</p><p><kbd>Shift</kbd> とホイールでは、端末の表示履歴を読みます。変換中、文字の選択中、質問や承認待ちでも、通常の端末スクロールです。端末内の検索は「⋮」か <span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>F</kbd></span> です。</p><h3 id="composer">長い指示を書く<a class="heading-anchor" href="#composer" aria-label="この節へのリンク">#</a></h3><p>タブ下の専用入力欄へは <span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>I</kbd></span>（Mac は <span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>I</kbd></span>）で移ります。<kbd>Enter</kbd> で送信、<span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Enter</kbd></span> で改行です。日本語の変換を確定しただけでは送信しません。</p><p>入力欄の表示は「設定 → 通知・配置・入力 → タブの下に入力欄を出す」で切り替えます。</p><p>「Claude メッセージを入力」などの専用入力欄には、最大 10 万文字を書けます。タブが低くなると自動で隠れるため、見えないときはタブの高さを広げます。シェルへ送る複数行は、1 行にまとめて渡します。</p><p>作業中のタブを閉じる前に、アプリの中で確認が出ます。</p>2a:["$","section","terminal",{"id":"terminal","children":[["$","h2",null,{"children":["ターミナルの出力をたどりたい",["$","a",null,{"className":"heading-anchor","href":"#terminal","aria-label":"この節へのリンク","children":"#"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<div class=\"section-summary\"><p aria-level=\"3\" role=\"heading\"><strong>要点</strong></p>\n<ul><li>出力中のファイルパスを押すと、成果物を開けます。</li><li>ターンチップから、前に送った指示と会話をたどれます。</li><li>長い指示は下の入力欄に書き、Enter で送ります。</li></ul></div>"}}]]}]],["$","nav",null,{"className":"section-jumps","aria-label":"ターミナルの出力をたどりたいの小見出し","children":[["$","a","conversation-view",{"href":"#conversation-view","children":"会話の表示と端末の表示"}],["$","a","pathlink",{"href":"#pathlink","children":"ファイルパスを開く"}],["$","a","turnchip",{"href":"#turnchip","children":"送った指示まで戻る"}],["$","a","conversation-history",{"href":"#conversation-history","children":"会話の全過去を読む"}],["$","a","composer",{"href":"#composer","children":"長い指示を書く"}],["$","a","copy-paste",{"href":"#copy-paste","children":"コピー、貼り付け、拡大"}],["$","a","status-dot",{"href":"#status-dot","children":"エージェントの状態と入力待ち"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$3b"}}]]}],"$L3c","$L3d"]]}]
