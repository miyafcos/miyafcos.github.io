":360,"y":67.25,"className":"title","children":"質問カードの帯　Claude Code の質問に選択肢で答える"}]]}]]}],["$","g","wt",{"className":"node n-box","data-w":696,"data-id":"wt","children":[["$","rect",null,{"x":12,"y":92,"width":696,"height":36,"rx":8}],["$","text",null,{"x":360,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":360,"y":115.25,"className":"title","children":"委譲の見守り　最終チェック・次回・停止の理由"}]]}]]}],["$","g","list",{"className":"node n-box","data-w":200,"data-id":"list","children":[["$","rect",null,{"x":12,"y":138,"width":200,"height":268,"rx":8}],["$","text",null,{"x":24,"textAnchor":"start","fontSize":15,"children":[["$","tspan","0",{"x":24,"y":173.75,"className":"title","children":"一覧（4 区分）"}],["$","tspan","1",{"x":24,"y":196.75,"className":"sub","children":"要回答"}],["$","tspan","2",{"x":24,"y":219.75,"className":"sub","children":"要確認"}],["$","tspan","3",{"x":24,"y":242.75,"className":"sub","children":"作業中"}],["$","tspan","4",{"x":24,"y":265.75,"className":"sub","children":"その他"}],["$","tspan","5",{"x":24,"y":288.75,"className":"sub","children":""}],["$","tspan","6",{"x":24,"y":311.75,"className":"sub","children":"計器行（各行の下）"}],["$","tspan","7",{"x":24,"y":334.75,"className":"sub","children":"モデル"}],["$","tspan","8",{"x":24,"y":357.75,"className":"sub","children":"コンテキスト占有率"}],["$","tspan","9",{"x":24,"y":380.75,"className":"sub","children":"概算コスト・ID"}]]}]]}],["$","g","chat",{"className":"node n-box","data-w":280,"data-id":"chat","children":[["$","rect",null,{"x":224,"y":138,"width":280,"height":206,"rx":8}],["$","text",null,{"x":364,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":364,"y":223.25,"className":"title","children":"会話列"}],["$","tspan","1",{"x":364,"y":246.25,"className":"sub","children":"会話を 1〜5 列"}],["$","tspan","2",{"x":364,"y":269.25,"className":"sub","children":"「固定」で留める"}]]}]]}],["$","g","in",{"className":"node n-box","data-w":280,"data-id":"in","children":[["$","rect",null,{"x":224,"y":354,"width":280,"height":52,"rx":8}],["$","text",null,{"x":364,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":364,"y":373.75,"className":"title","children":"入力欄"}],["$","tspan","1",{"x":364,"y":396.75,"className":"sub","children":"@ で宛先・Enter で送信"}]]}]]}],["$","g","map",{"className":"node n-box","data-w":192,"data-id":"map","children":[["$","rect",null,{"x":516,"y":138,"width":192,"height":268,"rx":8}],["$","text",null,{"x":612,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":612,"y":242.75,"className":"title","children":"配置図"}],["$","tspan","1",{"x":612,"y":265.75,"className":"sub","children":"ワークスペース"}],["$","tspan","2",{"x":612,"y":288.75,"className":"sub","children":"→ タブ → ペイン"}],["$","tspan","3",{"x":612,"y":311.75,"className":"sub","children":"クリックで列を開く"}]]}]]}]],"$undefined"]}],"$undefined",["$","svg",null,{"className":"fig-narrow","viewBox":"0 0 350 490","width":"100%","role":"img","aria-label":"ダッシュボードの見取り図。上に質問カードの帯と見守り、左に一覧、中央に会話列と入力欄、右に配置図","data-vw":350,"data-fs":15,"xmlns":"http://www.w3.org/2000/svg","children":[["$","title",null,{"children":"ダッシュボードの見取り図。上に質問カードの帯と見守り、左に一覧、中央に会話列と入力欄、右に配置図"}],["$","defs",null,{"children":[["$","marker",null,{"id":"F5-narrow-arrow","viewBox":"0 0 10 10","refX":"9","refY":"5","markerWidth":"8","markerHeight":"8","orient":"auto-start-reverse","children":["$","path",null,{"d":"M0 0L10 5L0 10z","className":"arrowhead"}]}],"$L2e"]}],[],["$L2f","$L30","$L31","$L32","$L33","$L34","$L35"],"$undefined"]}],"$L36"]}],"$L37","$L38","$L39","$L3a"]]}]
3b:["$undefined",["$","img",null,{"src":"/shots/05_pane-tabs.png","alt":"Claude Code のペインとアイコンに畳まれたペインの帯","width":610,"height":90,"loading":"lazy","decoding":"async"}]]
3c:T98b,<p>サイドバーのキャラクターにも、作業の状態が出ます。承認や質問では呼ぶ姿、エラーや枠切れでは困る姿、作業中は走る姿です。ターンが終わって未読なら知らせる姿、待機中なら寝る姿になります。待機バッジと合わせて、開く会話を選ぶ目印にできます。</p><p>承認の画面が 2 回続けて検出されなくなると、承認待ちを解除します。</p><h3 id="watch">見守りと無応答の検知<a class="heading-anchor" href="#watch" aria-label="この節へのリンク">#</a></h3><p>委譲の見守りは、同じ状態を 2 回続けて検知してから通知します。ダッシュボードには最終チェック時刻と、停止していればその理由が出ます。出力が少ないというだけでは、停止とは判定しません。</p><p>巡回で見つけた状態のうち、右下に知らせるのは人の操作が要る 3 種類だけです。判断を待っている、作業が検収で不合格になった、送信されていない入力が残っている、の 3 つです。知らせは「開発 の「調査レーン」が判断を待っています」のようにワークスペース名とペイン名で出て、「開く」でそのペインへ移ります。残りの状態はダッシュボードで確かめます。</p><p>標準の確認間隔は 10 分です。通知が多すぎる場合は、設定の「通知の敏感さ」で「控えめ」を選べます。見守りが停止中や未計測なら、帯に出る理由を確認します。</p><h3 id="rate-limit">レート制限と休眠<a class="heading-anchor" href="#rate-limit" aria-label="この節へのリンク">#</a></h3><p>レート制限で止まったペインは「停止」ではなく「レート制限で待機中」として扱い、休眠処理の対象から外します。休眠したセッションを片づける時間は、「設定 → 自動化」で 30 分後などから選べます。</p><h3 id="toast">トーストとエラー帯<a class="heading-anchor" href="#toast" aria-label="この節へのリンク">#</a></h3><p>短い知らせの置き場は、画面右下のトーストです。画面の一部が止まったときは、その部分だけエラー帯に変わり、「再試行」で戻せます。重ねて開いた画面は、<kbd>Esc</kbd> か背景のクリックで閉じます。</p>23:["$","section","notifications",{"id":"notifications","children":[["$","h2",null,{"children":["返事待ちや停止に気づきたい",["$","a",null,{"className":"heading-anchor","href":"#notifications","aria-label":"この節へのリンク","children":"#"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>通知の入口、委譲の見守り、レート制限の扱い、短い知らせの 4 つです。</p><h3 id=\"notification-panel\">待機バッジから移る<a class=\"heading-anchor\" href=\"#notification-panel\" aria-label=\"この節へのリンク\">#</a></h3><p>ペインとサイドバーの待機バッジで、人が関わらないと進まない状態に気づけます。該当するワークスペースとペインを選んで移ります。全ワークスペースの状態は、ダッシュボードでまとめて確かめます。</p><p>通知と通知サウンドは「設定 → 通知とレイアウト」で切り替えます。承認待ちの画面やレート制限が、検知の対象です。対応が必要なペインへは、<span class=\"keys\"><kbd>Ctrl</kbd><span class=\"key-join\">+</span><kbd>Alt</kbd><span class=\"key-join\">+</span><kbd>A</kbd></span> で直接移れます。</p><p>通知サウンドが有効なら、入力待ちを画面から見つけたときに短いチャイムが鳴ります。対象は表示中のワークスペースで、選んでいないペインだけです。裏のワークスペースの入力待ちでは鳴りません。</p>"}}]]}],["$","figure","1",{"className":"shot shot-content","data-shot":"05_pane-tabs","id":"shot-6-anchor","children":[["$","a",null,{"className":"shot-zoom-link","href":"#shot-6","aria-label":"Claude Code のペインとアイコンに畳まれたペインの帯 を大きく見る","children":["$","picture",null,{"children":"$3b"}]}],["$","figcaption",null,{"children":[["$","span",null,{"className":"fig-no","children":"図 6"}],"Claude Code の横に、アイコンに畳まれたペインが並んでいます。",["$","a",null,{"className":"shot-full","href":"#shot-6","children":"画像を大きく見る"}]]}],["$","div",null,{"className":"shot-viewer","id":"shot-6","children":[["$","a",null,{"className":"shot-viewer-close","href":"#shot-6-anchor","children":"閉じる"}],["$","img",null,{"src":"/shots/05_pane-tabs.png","alt":"Claude Code のペインとアイコンに畳まれたペインの帯","width":610,"height":90,"loading":"lazy"}]]}]]}],["$","div","2",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$3c"}}]]}]]]}]
24:["$","section","save",{"id":"save","children":[["$","h2",null,{"children":["作業を残して戻りたい",["$","a",null,{"className":"heading-anchor","href":"#save","aria-label":"この節へのリンク","children":"#"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>作業を残す手段は 3 つです。再起動時の自動復元、区切りで作るセーブポイント、別の PC へ渡す受け渡しファイルを、時間の順に並べます。</p>"}}]]}],["$","figure","1",{"className":"fig","data-fig":"F6","children":[["$","svg",null,{"className":"fig-wide","viewBox":"0 0 720 330","width":"100%","role":"img","aria-label":"今日・翌日・別の PC の時間軸に沿って、セーブポイントの作成、再開、受け渡しを並べた図","data-vw":720,"data-fs":15,"xmlns":"http://www.w3.org/2000/svg","children":[["$","title",null,{"children":"今日・翌日・別の PC の時間軸に沿って、セーブポイントの作成、再開、受け渡しを並べた図"}],["$","defs",null,{"children":[["$","marker",null,{"id":"F6-wide-arrow","viewBox":"0 0 10 10","refX":"9","refY":"5","markerWidth":"8","markerHeight":"8","orient":"auto-start-reverse","children":["$","path",null,{"d":"M0 0L10 5L0 10z","className":"arrowhead"}]}],["$","marker",null,{"id":"F6-wide-arrow-accent","viewBox":"0 0 10 10","refX":"9","refY":"5","markerWidth":"8","markerHeight":"8","orient":"auto-start-reverse","children":["$","path",null,{"d":"M0 0L10 5L0 10z","className":"arrowhead accent"}]}]]}],[["$","g","0",{"children":[["$","path",null,{"d":"M120 152L120 194","className":"edge","markerEnd":"$undefined","markerStart":"$undefined"}],"$undefined"]}],["$","g","1",{"children":[["$","path",null,{"d":"M360 152L360 194","className":"edge","markerEnd":"$undefined","markerStart":"$undefined"}],"$undefined"]}],["$","g","2",{"children":[["$","path",null,{"d":"M600 152L600 194","className":"edge","markerEnd":"$undefined","markerStart":"$undefined"}],"$undefined"]}]],[["$","g","d1",{"className":"node n-box","data-w":200,"data-id":"d1","children":[["$","rect",null,{"x":20,"y":0,"width":200,"height":86,"rx":8}],["$","text",null,{"x":120,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":120,"y":25.25,"className":"title","children":"「セー