3c:["$","div","2",{"data-shot":"08_dashboard","data-figure-number":4,"children":["$","$L34",null,{"entry":{"id":"dashboard","theme":"dark","role":"detail","os":"windows","file":"/media/dashboard-dark-af15445749b2-crop-980c8ce6-160w.webp","srcSet":"/media/dashboard-dark-af15445749b2-crop-980c8ce6-160w.webp 160w, /media/dashboard-dark-af15445749b2-crop-980c8ce6-400w.webp 400w, /media/dashboard-dark-af15445749b2-crop-980c8ce6-712w.webp 712w, /media/dashboard-dark-af15445749b2-crop-980c8ce6-768w.webp 768w, /media/dashboard-dark-af15445749b2-crop-980c8ce6-1200w.webp 1200w, /media/dashboard-dark-af15445749b2-crop-980c8ce6-1424w.webp 1424w","original":"/media/originals/dashboard-dark-af15445749b2-crop-980c8ce6.png","width":1424,"height":1171,"cssWidth":712,"appFontPx":11,"terminalFontPx":14,"uiFontScale":1,"geometryOk":true,"maxDisplayHeight":640,"readableWidth":712,"caption":"ダッシュボードで、2 本の会話と見出しを選ぶ質問カードを並べています。","alt":"ダッシュボードの左右に会話の列、左の会話の下にレポートの見出しを選ぶ質問カードが出ている画面。","sample":false,"composite":false,"hotspots":[],"fallback":false,"assets":[{"file":"/media/dashboard-dark-af15445749b2-crop-980c8ce6-160w.webp","width":160,"height":132,"bytes":3686,"sha256":"7b27cae3e7932dc3d505f2f68f134272c398f4942ce196c0a997fc99b676f09a"},{"file":"/media/dashboard-dark-af15445749b2-crop-980c8ce6-400w.webp","width":400,"height":329,"bytes":16176,"sha256":"f7a86b40ecbd99e9e00567293b36e0e7014cf05b552e640a98805ee8fff3f388"},{"file":"/media/dashboard-dark-af15445749b2-crop-980c8ce6-712w.webp","width":712,"height":586,"bytes":42216,"sha256":"ea368e5c7799b1d31537dd41c28c7a99b07287b6895a646edb49760f4bd80b24"},{"file":"/media/dashboard-dark-af15445749b2-crop-980c8ce6-768w.webp","width":768,"height":632,"bytes":45912,"sha256":"4663ba1f46a29f7e4d926e15e879503fdbc2068fa4b9918342f4410aa5af0229"},{"file":"/media/dashboard-dark-af15445749b2-crop-980c8ce6-1200w.webp","width":1200,"height":987,"bytes":87126,"sha256":"8e0e8e9f1468250dd0852a0e76c717ec23de64878c7018ef5fee3a0f3a9163f0"},{"file":"/media/dashboar