null,{"x":30,"y":220,"width":290,"height":76,"rx":8}],["$","text",null,{"x":175,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":175,"y":251.75,"className":"title","children":"行をクリックで切替"}],["$","tspan","1",{"x":175,"y":274.75,"className":"sub","children":"PC 全体の CLI ログイン"}]]}]]}],["$","g","n",{"className":"node n-plain","data-w":350,"data-id":"n","children":[false,["$","text",null,{"x":175,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":175,"y":353.75,"className":"title","children":"外で動く CLI は検知できない"}],["$","tspan","1",{"x":175,"y":376.75,"className":"sub","children":"Codex の使用量は取得できない"}]]}]]}]],"$undefined"]}]
