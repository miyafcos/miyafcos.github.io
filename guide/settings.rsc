0 10 10","refX":"9","refY":"5","markerWidth":"8","markerHeight":"8","orient":"auto-start-reverse","children":["$","path",null,{"d":"M0 0L10 5L0 10z","className":"arrowhead accent"}]}]]}],[["$","g","0",{"children":[["$","path",null,{"d":"M175 76L175 110","className":"edge","markerEnd":"url(#F8-narrow-arrow)","markerStart":"$undefined"}],"$undefined"]}],["$","g","1",{"children":[["$","path",null,{"d":"M175 186L175 220","className":"edge","markerEnd":"url(#F8-narrow-arrow)","markerStart":"$undefined"}],"$undefined"]}]],[["$","g","m",{"className":"node n-box","data-w":290,"data-id":"m","children":[["$","rect",null,{"x":30,"y":0,"width":290,"height":76,"rx":8}],["$","text",null,{"x":175,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":175,"y":31.75,"className":"title","children":"「アカウントと使用量」"}],["$","tspan","1",{"x":175,"y":54.75,"className":"sub","children":"Claude・Codex・Grok の使用率"}]]}]]}],["$","g","p",{"className":"node n-box","data-w":290,"data-id":"p","children":[["$","rect",null,{"x":30,"y":110,"width":290,"height":76,"rx":8}],["$","text",null,{"x":175,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":175,"y":141.75,"className":"title","children":"アカウント一覧"}],["$","tspan","1",{"x":175,"y":164.75,"className":"sub","children":"行ごとの使用率と取得時刻"}]]}]]}],["$","g","s",{"className":"node n-accent","data-w":290,"data-id":"s","children":[["$","rect",null,{"x":30,"y":220,"width":290,"height":76,"rx":8}],"$L27"]}],"$L28"],"$undefined"]}],"$undefined","$L29"]}]
1a:["$","details","6",{"className":"guide-details","children":[["$","summary",null,{"id":"usage-fetch","children":"使用量の取得の注意と、値の読み方"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>Claude の使用量取得は、非公式の接続先を使います。追加や自動取得にはアカウント制限のリスクがあるため、設定画面の説明を読んでから使ってください。</p>\n<table class=\"two-column-table\">\n<thead>\n<tr><th>表示</th><th>読み方</th></tr></thead>\n<tbody>\n<tr><td data-label=\"表示\">「5h」「7d」</td><td data-label=\"読み方\">5 時間枠と週次枠の使用率です。</td></tr>\n<tr><td data-label=\"表示\">モデル別の週次枠</td><td data-label=\"読み方\">接続先から取得できた枠を表示します。</td></tr>\n<tr><td data-label=\"表示\">「取得時刻」「状態」</td><td data-label=\"読み方\">値の新しさと、取得できない理由を確認します。</td></tr></tbody></table><p>取得を休んでいる間も、前回の値を薄く表示します。再開予定の時刻は推定です。</p><p>「今回の取得は見送りました」は、その回の取得を見送った行に出る表示です。10 分以内に取れた値があれば、前回の数字を残します。使用中のアカウントから優先して取得します。</p>"}}]]}]]}]]}]
1b:["$","div","7",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<h3 id=\"tab-accounts\">タブごとのアカウント<a class=\"heading-anchor\" href=\"#tab-accounts\" aria-label=\"この節へのリンク\">#</a></h3><p>ランチャーや新しいワークスペースの「アカウント」欄で、Claude Code、Codex、Grok のアカウントをタブごとに選べます。未登録のアカウントは「タブでも使う」から登録を始められます。</p><p>Claude は「始める」で <code>claude setup-token</code> が裏で動き、ブラウザの承認コードを貼って登録します。長期トークンは OS の秘密領域に保存します。この方式の Claude では、Claude.ai へのサインインが必要な機能は使えません。</p><p>Codex と Grok はタブ用ログインを使います。タブの名札と ⋮ の「このタブのアカウント」で確認状態や使用量を確かめられます。</p><h3 id=\"reset-tickets\">リセット券を使う<a class=\"heading-anchor\" href=\"#reset-tickets\" aria-label=\"この節へのリンク\">#</a></h3><p>タイトルバーの「アカウントと使用量」で、Claude Code と Codex のリセット券を確認できます。券があるアカウントには、残数と、分かる場合は期限が出ます。券を押し、確認内容を読んで「使う」を選ぶと 1 枚使い、使用量を取り直します。</p><p>券を使える条件はアカウントによって違い、使えない理由も表示します。Claude Code は週のリセット日時を保ち、Codex は次に使った時点から週の枠を数え直します。確認画面で、戻る使用量と日時を確かめてください。</p><p>Claude Code の券は、直前の照会が通信の制限などで失敗しても申し込める場合があります。同じアカウントと組織の、10 分以内の確認結果が必要です。最終の判定はサーバ側で行い、認証のエラーや期限切れは対象外です。</p>"}}]]}]
1c:["$","details","8",{"className":"guide-details","children":[["$","summary",null,{"id":"usage-2","children":"自動でアカウントを切り替える"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>「設定 → アカウント・使用量」で、プロバイダーごとに自動切り替えを設定できます。既定はオフです。エージェントごとに、一覧の「候補」で切り替え先を選べます。</p><p>新しく登録したアカウントは、最初から候補に入ります。</p><p>5 時間枠か週次枠が上限に達すると、候補のうち空きがいちばん多いアカウントへ移します。</p><h4>切り替えの間隔と確認</h4><p>切り替えたあとは、その完了から 5 分以上あけます。判断に使う使用量は、5 分以内に取得できたものだけです。不明な枠を空きとは扱いません。</p><p>端末に一般的な「リクエストが多すぎる」（HTTP 429）が出ただけでも切り替えません。候補に空きがなければ知らせて、オンのまま待ちます。</p><p>切り替え失敗、切り替え後の警告、切り替えても上限が続くときはオフになります。自動の場合も PC 全体の CLI ログインに効くため、アプリ外の作業も含めて使い方を決めてください。</p>"}}]]}]]}]]}]
2a:Td24,<table class="two-column-table">
<thead>
<tr><th>層</th><th>画面の名前</th></tr></thead>
<tbody>
<tr>
<td data-label="層">1</td><td data-label="画面の名前">「本体（生身）」</td></tr>
<tr>
<td data-label="層">2</td><td data-label="画面の名前">「実行の設定と権限」</td></tr>
<tr>
<td data-label="層">3</td><td data-label="画面の名前">「指示とルール」</td></tr>
<tr>
<td data-label="層">4</td><td data-label="画面の名前">「記憶と記録」</td></tr>
<tr>
<td data-label="層">5</td><td data-label="画面の名前">「道具と手順」</td></tr>
<tr>
<td data-label="層">6</td><td data-label="画面の名前">「自動化」</td></tr>
<tr>
<td data-label="層">7</td><td data-label="画面の名前">「参照資料と設計」</td></tr></tbody></table>
<table class="two-column-table">
<thead>
<tr><th>画面</th><th>確かめること</th></tr></thead>
<tbody>
<tr><td data-label="画面">「しくみ」</td><td data-label="確かめること">役割と置き場所の地図です。</td></tr>
<tr><td data-label="画面">「概要」</td><td data-label="確かめること">起動や会話の始めに読む量と内訳です。</td></tr>
<tr><td data-label="画面">「読み方」</td><td data-label="確かめること">起動から会話の終わりまで、いつ何を読むかです。</td></tr>
<tr><td data-label="画面">「比べる」</td><td data-label="確かめること">Claude Code と Codex の設定の違いです。</td></tr>
<tr><td data-label="画面">「点検」</td><td data-label="確かめること">重なり、一覧の量、使われた記録などです。</td></tr>
<tr><td data-label="画面">「スキル」</td><td data-label="確かめること">読むための棚、中身、構成と置き場所です。</td></tr>
<tr><td data-label="画面">「ふりかえり」</td><td data-label="確かめること">AI ログの使用量をグラフや表で見ます。</td></tr>
<tr><td data-label="画面">「履歴」</td><td data-label="確かめること">2 つの時点を選び、文書や設定の差を見ます。</td></tr>
<tr><td data-label="画面">「書き出し」</td><td data-label="確かめること">選んだ範囲を HTML の設計書にまとめます。</td></tr></tbody></table><p>一覧から、対応する全 22 種類の本文を開けます。Markdown、行番号付きの原文、見出しの目次、文書の属性の表で読み分けられます。この画面から、設定や文書を書き換えたり、スキルを起動したりはしません。</p><p>点検では、現在のアカウントの同期スキルと、ほかのアカウントの控えを区別します。無効や手動専用のスキルは、重なりや一覧の字数から外します。読めない設定は不明、今の設定を当てた一覧の量は推定と表示します。</p><p>「履歴」の比較に、記憶の本文は含めません。HTML の書き出しも、記憶、鍵、会話の本文を除きます。除外項目を先に示し、名前の検査に当たると保存を止めます。</p><p>鍵らしい値は伏せ字で、選んだ 1 値だけを 15 秒間表示できます。画面を離れると隠し、履歴や書き出しには値を残しません。目録は <code>~/.mycmux/agent_design/</code> に保存します。</p>1d:["$","section","agent-design",{"id":"agent-design","children":[["$","h2",null,{"children":["エージェントの設定と指示を見渡したい",["$","a",null,{"className":"heading-anchor","href":"#agent-design","aria-label":"この節へのリンク","children":"#"}]]}],[],false,[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>上の帯の剣と盾の印から「エージェント設計」を開きます。最初に出る「しくみ」の地図で、設定、指示、記憶、スキルの役割と置き場所を見ます。スキルは、エージェントが読む手順をまとめた文書です。Claude Code と Codex を 7 つの層で読み、Hermes は名前や有無、数を確認する範囲です。</p>"}}]]}],["$","details","1",{"className":"guide-details","children":[["$","summary",null,{"id":"agent-design-details","children":"7 つの層と、画面の使い分け"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$2a"}}]]}]]}]]}]]]}]
2b:T978,<p>上段には期間のサマリーと日ごとの積み上げ棒が並びます。棒を選び、「この日に絞り込む」でその日を調べられます。セッション一覧の「主題」からは、個別の詳細へ進めます。</p><p>表示する金額はログと単価から出した<strong>コスト相当</strong>で、請求額そのものではありません。集計には既知の課題もあるため、欠落や未取り込みを含む参考値として使います。</p>
<table class="two-column-table">
<thead>
<tr><th>見る場所</th><th>分かること</th></tr></thead>
<tbody>
<tr><td data-label="見る場所">「内訳」</td><td data-label="分かること">作業やモデルごとの内訳です。</td></tr>
<tr><td data-label="見る場所">「比較」</td><td data-label="分かること">2 つの切り口で比べます。</td></tr>
<tr><td data-label="見る場所">「セッション」</td><td data-label="分かること">検索、並べ替え、個別の詳細です。</td></tr>
<tr><td data-label="見る場所">「手戻り」</td><td data-label="分かること">失敗や書き直しを調べます。</td></tr>
<tr><td data-label="見る場所">「モデル切替」</td><td data-label="分かること">モデルの切り替えを調べます。</td></tr>
<tr><td data-label="見る場所">「活動時間」</td><td data-label="分かること">曜日と時間帯ごとの活動です。</td></tr></tbody></table><p>指標は入出力トークン、総トークン、ターン数、セッション数、コスト相当から選べます。モデル、会社、案件などでまとめ直せます。</p><p>「カスタム」の期間は、開始日と終了日の両方を選んで確定します。取り込みをやり直す場合は、上部の「⋮」から「再インデックス（全量）」を選びます。</p><p>詳細では、作業フォルダや要約、ターンごとのコスト相当、ツールの実行結果を確かめられます。「会話を読み込む」で本文を読み込みます。</p><p>元の記録がないときは、同名の圧縮ファイルや設定した代わりの場所、控えも探します。集計の一部が失敗しても読めた表やグラフを残し、失敗した対象を再試行できます。「このセッションを要約する」は、AI を有効にしているときに使えます。</p>1e:["$","section","logs",{"id":"logs","children":[["$","h2",null,{"children":["何にコストがかかったかを見たい",["$","a",null,{"className":"heading-anchor","href":"#logs","aria-label":"この節へのリンク","children":"#"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<div class=\"section-summary\"><p aria-level=\"3\" role=\"heading\"><strong>要点</strong></p>\n<ul><li>「エージェント設計」の「ふりかえり」で、期間を選んで使用量を見ます。</li><li>作業種別や推移から、個別の会話の内訳へ進めます。</li><li>金額はログと単価から出すコスト相当で、請求額ではありません。</li></ul></div>"}}]]}]],false,[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>「エージェント設計」の「ふりかえり」を開きます。AI ログ分析では、この PC にあるエージェントの記録を検索用にまとめます。この機能は <strong>ailog</strong> とも呼びます。</p><p>画面を開くだけでは、言語モデルを起動しません。日ごとの集計を保存するため、保存済みの集計があれば開いたときにすぐ表示します。最新分は裏で集計し、できた結果へ差し替えます。</p>"}}]]}],["$","$L18","1",{"entry":"$undefined","sizes":"(max-width: 767px) 92vw, 720px"}],["$","div","2",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>Gemini の利用分も、ログに記録されたモデルの単価を使って集計します。</p><p>期間は「7日」「30日」「90日」「今年」「全期間」「カスタム」から選びます。円換算のレートは手入力です。「記録は〜まで」「未取り込み」の表示で、集計の範囲を確かめます。</p>"}}]]}],["$","details","3",{"className":"guide-details","children":[["$","summary",null,{"id":"logs-1","children":"作業の内訳をたどる"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$2b"}}]]}]]}]]}]]]}]
2c:T190d,<p>設定は 5 つの群に分かれ、タブは 13 あります。</p>
<table class="two-column-table">
<thead>
<tr><th>群</th><th>タブ</th></tr></thead>
<tbody>
<tr><td data-label="群">「表示」</td><td data-label="タブ">「外観」「キャラ」「通知・配置・入力」</td></tr>
<tr><td data-label="群">「作業」</td><td data-label="タブ">「このPCの履歴から再開」「使うサービス」「ランチャー」「セーブポイント」「AI」「自動化」</td></tr>
<tr><td data-label="群">「接続」</td><td data-label="タブ">「スマホから使う」</td></tr>
<tr><td data-label="群">「アカウント」</td><td data-label="タブ">「アカウント・使用量」</td></tr>
<tr><td data-label="群">「その他」</td><td data-label="タブ">「キーボードショートカット」「アプリ情報」</td></tr></tbody></table>
<table class="two-column-table">
<thead>
<tr><th>タブ</th><th>このタブで決められること</th></tr></thead>
<tbody>
<tr><td data-label="タブ">「外観」</td><td data-label="このタブで決められること">テーマ、壁紙、文字の大きさ、端末フォント、色です。</td></tr>
<tr><td data-label="タブ">「キャラ」</td><td data-label="このタブで決められること">ペットの表示、候補、ワークスペースへの割り当てです。</td></tr>
<tr><td data-label="タブ">「通知・配置・入力」</td><td data-label="このタブで決められること">通知音、トースト、「⋮」の分割項目、入力先と履歴の読み方です。</td></tr>
<tr><td data-label="タブ">「このPCの履歴から再開」</td><td data-label="このタブで決められること">履歴の検索対象や絞り込み、一覧の表示です。</td></tr>
<tr><td data-label="タブ">「使うサービス」</td><td data-label="このタブで決められること">エージェントのサービスごとの表示です。記録や使用量は消しません。</td></tr>
<tr><td data-label="タブ">「ランチャー」</td><td data-label="このタブで決められること">起動項目や「ターミナル」の表示と、開発や案件のフォルダ登録です。</td></tr>
<tr><td data-label="タブ">「セーブポイント」</td><td data-label="このタブで決められること">保存済みの一覧を開き、記録を受け取ります。</td></tr>
<tr><td data-label="タブ">「AI」</td><td data-label="このタブで決められること">AI の有効化、使うモデル、各機能、Claude Code スキル、エージェント連携です。</td></tr>
<tr><td data-label="タブ">「自動化」</td><td data-label="このタブで決められること">見守り、自律モード、気づき、休眠セッションの整理です。</td></tr>
<tr><td data-label="タブ">「スマホから使う」</td><td data-label="このタブで決められること">「ポケットmycmux」の接続先と QR コードを確かめます。</td></tr>
<tr><td data-label="タブ">「アカウント・使用量」</td><td data-label="このタブで決められること">ログインの管理、使用量、自動切り替え、単価です。</td></tr>
<tr><td data-label="タブ">「キーボードショートカット」</td><td data-label="このタブで決められること">キーの割り当てと、既定への戻し方です。</td></tr>
<tr><td data-label="タブ">「アプリ情報」</td><td data-label="このタブで決められること">版番号と更新の確認です。</td></tr></tbody></table><p>新しい切り離しは、Windows と Mac の両方で既定でオンです。「通知・配置・入力」で前の動きへ戻せます。Windows は「タブの切り離しを新しい動きにする (試験中)」です。</p><p>Mac は「Macの窓の切り離しを新しい動きにする (試験中)」です。</p><p>アプリの更新は、「設定 → アプリ情報 → 更新を確認」で確かめます。新しい版があると右上に青い更新マークが出ます。どちらからも今の版と新しい版の確認枠を開き、「更新して再起動」か「あとで」を選べます。</p><p>画面右上のメールアイコンから、改善の要望を送れます。事前に「設定 → アプリ情報 → 改善の要望の送り先」を登録します。種類、機能、内容、急ぎ度などと、窓のスクショを最大 3 枚添えられます。</p>
<table class="two-column-table">
<thead>
<tr><th>変えるもの</th><th>設定の場所</th></tr></thead>
<tbody>
<tr><td data-label="変えるもの">テーマ 30 本</td><td data-label="設定の場所">「外観 → テーマ → すべてのテーマを表示（30）」。「静かな暗色」「個性の強い暗色」「明るい配色」の 3 つに分かれます。</td></tr>
<tr><td data-label="変えるもの">壁紙 11 枚</td><td data-label="設定の場所">「外観 → 詳しく調整 → 背景」。選んだときにダウンロードします。</td></tr>
<tr><td data-label="変えるもの">背景の見え方</td><td data-label="設定の場所">「外観 → 背景の見え方」で「塗りつぶし」「すりガラス」「クリア」の 3 択。細かくはスライダー 5 本で調整します。</td></tr>
<tr><td data-label="変えるもの">端末フォント 10 プリセット（設定画面）</td><td data-label="設定の場所">「外観 → 端末フォント」</td></tr>
<tr><td data-label="変えるもの">画面の密度と色</td><td data-label="設定の場所">「外観 → 詳しく調整 → 画面の余白と文字の大きさ」で「つめる」「標準」「ゆったり」。色は「選んだテーマの微調整」に 12 種のプリセットがあります。</td></tr>
<tr><td data-label="変えるもの">キーの割り当て</td><td data-label="設定の場所">「キーボードショートカット → 変更」でキーを入力します。</td></tr></tbody></table><p><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>,</kbd></span>（Mac は <span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>,</kbd></span>）でもショートカット設定を開けます。「戻す」で 1 件ずつ既定に戻せます。全件を戻すときは「既定に戻す」を押します。</p>1f:["$","section","appearance",{"id":"appearance","children":[["$","h2",null,{"children":["見た目やキーを変えたい",["$","a",null,{"className":"heading-anchor","href":"#appearance","aria-label":"この節へのリンク","children":"#"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<div class=\"section-summary\"><p aria-level=\"3\" role=\"heading\"><strong>要点</strong></p>\n<ul><li>「設定 → 外観 → かんたん設定」で、テーマと文字の大きさを選びます。</li><li>壁紙や色を細かく変えるときは「詳しく調整する」を開きます。</li><li>キーは「キーボードショートカット」で割り当て、既定へ戻せます。</li></ul></div>"}}]]}]],["$","nav",null,{"className":"section-jumps","aria-label":"見た目やキーを変えたいの小見出し","children":[["$","a","settings-tabs",{"href":"#settings-tabs","children":"設定 13 タブの一覧と、各操作の入口"}],["$","a","appearance-1",{"href":"#appearance-1","children":"かんたん設定から選ぶ"}],["$","a","appearance-2",{"href":"#appearance-2","children":"壁紙、配色、描画を調整する"}],["$","a","input-operation",{"href":"#input-operation","children":"右クリックとキー割り当ての操作"}]]}],[["$","details","0",{"className":"guide-details","children":[["$","summary",null,{"id":"settings-tabs","children":"設定 13 タブの一覧と、各操作の入口"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$2c"}}]]}]]}]]}],"$L2d","$L2e","$L2f","$L30"]]}]
20:["$","section","automation",{"id":"automation","children":[["$","h2",null,{"children":["AI と自動化を止めたい",["$","a",null,{"className":"heading-anchor","href":"#automation","aria-label":"この節へのリンク","children":"#"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<div class=\"section-summary\"><p aria-level=\"3\" role=\"heading\"><strong>要点</strong></p>\n<ul><li>「設定 → AI」の親スイッチで、AI を使う機能を止められます。</li><li>「自動化」で見守りや通知、自動で片づける時間を選びます。</li><li>タブの自動命名と通常の再配置は、AI が無効でも使えます。</li></ul></div>"}}]]}]],["$","nav",null,{"className":"section-jumps","aria-label":"AI と自動化を止めたいの小見出し","children":[["$","a","automation-options",{"href":"#automation-options","children":"自動化と、個別設定の項目"}],["$","a","jev",{"href":"#jev","children":"タブ再配置に Jev を使う"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>「設定 → AI」の「Claude Code スキル」から、3 つのスキルと委譲 CLI を導入、更新できます。</p>\n<table class=\"two-column-table\">\n<thead>\n<tr><th>カードの状態</th><th>操作</th></tr></thead>\n<tbody>\n<tr><td data-label=\"カードの状態\">「未導入」</td><td data-label=\"操作\">「導入」で用意します。</td></tr>\n<tr><td data-label=\"カードの状態\">「更新あり」</td><td data-label=\"操作\">「更新」で配布された内容へ更新します。</td></tr>\n<tr><td data-label=\"カードの状態\">「最新」</td><td data-label=\"操作\">導入済みの内容を使えます。</td></tr>\n<tr><td data-label=\"カードの状態\">「ローカル改変」</td><td data-label=\"操作\">変更内容を確認し、「退避して置き換える」を選びます。</td></tr></tbody></table><p>前提は Claude Code と Python 3.10 以上です。導入時に問題があれば、カードの結果と「再確認」を使います。</p><p>「設定 → AI」の「エージェント連携」で、Claude Code、Codex、Grok の連携状態を見られます。終了や質問を mycmux に知らせる仕組みを hook と呼びます。必要に応じて「入れる」「直す」「外す」を選べます。</p><p>「設定 → AI」の「AI機能を有効にする」が親スイッチです。オフにすると、返信案の準備など、AI を使う機能が止まります。材料から表示名を付ける自動命名は、そのまま使えます。</p><p>「設定 → 自動化」では、見守り、自律モード、通知の敏感さ、休眠セッションの整理時間を決めます。</p>"}}]]}],["$","details","1",{"className":"guide-details","children":[["$","summary",null,{"id":"automation-options","children":"自動化と、個別設定の項目"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<table class=\"two-column-table\">\n<thead>\n<tr><th>「自動化」の項目</th><th>決めること</th></tr></thead>\n<tbody>\n<tr><td data-label=\"「自動化」の項目\">「見守りを有効にする」</td><td data-label=\"決めること\">委譲した作業の定期確認です。</td></tr>\n<tr><td data-label=\"「自動化」の項目\">「通知の敏感さ」</td><td data-label=\"決めること\">「控えめ」「標準」「敏感」などを選びます。</td></tr>\n<tr><td data-label=\"「自動化」の項目\">「見守りの通知を出す」</td><td data-label=\"決めること\">確認結果を通知するか決めます。</td></tr>\n<tr><td data-label=\"「自動化」の項目\">「休眠セッションの整理」</td><td data-label=\"決めること\">自動整理しないか、30 分、60 分、120 分後かを選びます。</td></tr>\n<tr><td data-label=\"「自動化」の項目\">「実行契約の次の作業を自動で始める」</td><td data-label=\"決めること\">自律モードを切り替えます。</td></tr>\n<tr><td data-label=\"「自動化」の項目\">「先回りカード (気づき)」</td><td data-label=\"決めること\">以前の気づきカードの仕組みを切り替えます。ダッシュボードの「気づき」列のカードは、この設定では止まりません。</td></tr></tbody></table><p>個別設定には、返信案の準備、報告の要約、タブ整理の判定があります。AI ログ分析の要約も個別に切り替えられます。</p><p>「タブの自動命名」は、既定でオンです。AI を使わず、案件登録やフォルダ、会話の題名から表示名を付けます。オフにすると、前に付いた自動の名前を外します。</p><p>タブの並べ替えは「タブ再配置」から行えます（<a href=\"/guide/screen#reflow\">案の見方</a>）。</p>"}}]]}]]}]]}],["$","details","2",{"className":"guide-details","children":[["$","summary",null,{"id":"jev","children":"タブ再配置に Jev を使う"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>OpenRouter は、複数の AI を呼び出せる外部サービスです。Jev は、OpenRouter 経由で「役割で見渡す」の役割を判定する機能です。既定は無効で、AI と Jev を両方有効にした場合だけ使います。</p><p>無効のままなら、3 つの再配置案は手元の材料だけで作ります。</p>\n<ol><li>「設定 → AI」で「AI機能を有効にする」をオンにします。</li><li>Jev の再配置設定で、「OpenRouter APIキー」と「Jevのモデル」を入力します。</li><li>「接続テスト」を押し、結果を確認します。</li><li>「役割で見渡す」の役割判定に Jev を使う項目をオンにし、「Jev設定を保存」を押します。</li></ol><p>API キーは、この端末の OS の保護機能で保存します。役割の判定では、タブ名、作業フォルダ、題名、親子関係を OpenRouter 経由で送ります。接続テストは短い確認データを送り、API の利用料が発生します。</p><p>案の選び方と適用後の確認は、<a href=\"/guide/screen#reflow\">タブをまとめ直す</a>にあります。</p>"}}]]}]]}]]}]]]}]
21:["$","section","remote",{"id":"remote","children":[["$","h2",null,{"children":["スマホやキャラクターを使いたい",["$","a",null,{"className":"heading-anchor","href":"#remote","aria-label":"この節へのリンク","children":"#"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<div class=\"section-summary\"><p aria-level=\"3\" role=\"heading\"><strong>要点</strong></p>\n<ul><li>「設定 → スマホから使う」で、配信済みの接続先を確かめます。</li><li>QR はスマホのブラウザで開く入口で、iPhone アプリを直接開きません。</li><li>Buddy やペットの表示は「キャラ」で選び、表示しない形も使えます。</li></ul></div>"}}]]}]],["$","nav",null,{"className":"section-jumps","aria-label":"スマホやキャラクターを使いたいの小見出し","children":[["$","a","mobile",{"href":"#mobile","children":"スマホから開く"}],["$","a","buddy",{"href":"#buddy","children":"Buddy とペット"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>スマホからの接続と、デスクトップのキャラクターの設定です。</p><h3 id=\"mobile\">スマホから開く<a class=\"heading-anchor\" href=\"#mobile\" aria-label=\"この節へのリンク\">#</a></h3><p>「設定 → スマホから使う」で、「ポケットmycmux」の接続先を確かめます。iPhone 用のアプリと入手の状況は、<a href=\"/pocket\">ポケット</a>にまとめています。</p><p>Tailscale は、離れた PC とスマホをつなぐためのサービスです。QR コードと URL が出るのは、Tailscale の <code>tailscale serve</code> で <code>/pocket</code> を配信しているときだけです。設定を開くたびに接続先を調べるので、ホスト名が変わっても新しい URL を表示します。</p><p>配信中でも応答がない場合は、URL の下に注意書きが出ます。</p>\n<ol>\n<li>PC 側で「ポケットmycmux」のサーバと、Tailscale の配信を用意します。</li><li>「設定 → スマホから使う」を開き、QR コードと注意書きを確かめます。</li><li>スマホで QR コードを読み、ブラウザで「ポケットmycmux」を開きます。</li></ol><p>現在、QR コードから iPhone アプリが直接起動することはありません。QR が出ない場合は、「ポケットmycmux」のサーバと配信の設定を確かめてください。</p><p>mycmux 内蔵のモバイル画面と、その接続用サーバはなくなりました。リモート接続の有効化、LAN 公開、接続中端末の一覧、トークンの再生成もありません。以前の接続設定は読み飛ばすため、設定ファイルを手で直す必要はありません。</p>"}}]]}],["$","details","1",{"className":"guide-details","children":[["$","summary",null,{"id":"buddy","children":"Buddy とペット"}],["$","div",null,{"className":"guide-details-body","children":[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>Buddy は、エージェントの活動に合わせて発話するデスクトップのキャラクターです。標準ビルド（配布版）では、既定の顔を表示します。</p><p>新しく入れたときは、キャラを表示しない状態（「キャラなし」）から始まります。以前の版から使っている場合は、保存されている選択がそのまま残ります。</p><p>ワークスペースのペットは「設定 → キャラ」で選びます。ワークスペースに 1 体出すか、表示しないかの 2 択です。「変更 ▸」で割り当てを変え、「今すぐ再スキャン」で追加したペットを読み直します。</p><p>同じ窓で使っているキャラを避ける抽選が既定です。候補を使い切ると再び抽選し、残りは保存して再起動後も引き継ぎます。既存の割り当ては保ち、以前のランダム方式へ戻すこともできます。</p><p>ペットは候補に入れるものを選び、ワークスペースに固定するか、候補から選ぶかを決められます。「ギャラリー」で絵柄を確かめ、隔離したものは戻せます。</p>"}}]]}]]}]]}]]]}]
31:T3ee1,<p>画面の操作に割り当てられた 38 件を、用途ごとに並べました。下の表は OS ごとの既定キーで、自分で変更した設定があればそちらを使います。</p><h3 id="keys-workspace">ワークスペースを作り、切り替える<a class="heading-anchor" href="#keys-workspace" aria-label="この節へのリンク">#</a></h3>
<table>
<thead>
<tr><th>画面の項目名</th><th>Windows</th> <th>Mac</th>
</tr>
</thead>
<tbody>
<tr><td data-label="画面の項目名">「新しいワークスペース」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>N</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>N</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「新しいワークスペース (エージェントを選ぶ)」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>N</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>N</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「次のワークスペース」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Tab</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Tab</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「前のワークスペース」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>Tab</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>Tab</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ワークスペースを閉じる」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>W</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>W</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ワークスペース 1 へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>1</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>1</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ワークスペース 2 へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>2</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>2</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ワークスペース 3 へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>3</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>3</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ワークスペース 4 へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>4</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>4</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ワークスペース 5 へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>5</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>5</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ワークスペース 6 へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>6</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>6</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ワークスペース 7 へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>7</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>7</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ワークスペース 8 へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>8</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>8</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「最後のワークスペースへ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>9</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>9</kbd></span></td>
</tr>
</tbody>
</table><h3 id="keys-panes">タブと表示場所を操作する<a class="heading-anchor" href="#keys-panes" aria-label="この節へのリンク">#</a></h3>
<table>
<thead>
<tr><th>画面の項目名</th><th>Windows</th> <th>Mac</th>
</tr>
</thead>
<tbody>
<tr><td data-label="画面の項目名">「左のタブへ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>←</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>←</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「右のタブへ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>→</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>→</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「上のタブへ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>↑</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>↑</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「下のタブへ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>↓</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>↓</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「右にタブを開く」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>D</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>D</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「下にタブを開く」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>D</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>D</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「表示中のタブを閉じる」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>W</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>W</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「閉じたタブを開き直す」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>T</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>T</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「このタブだけ表示・元の表示に戻す」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>Enter</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>Enter</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「同じ場所の次のタブ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>PageDown</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>PageDown</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「同じ場所の前のタブ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>PageUp</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>PageUp</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「次の要対応へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>A</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>A</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「表示中のタブを並びの先頭に固定」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>P</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>P</kbd></span></td>
</tr>
</tbody>
</table><h3 id="keys-conversation">一覧、会話と設定を開く<a class="heading-anchor" href="#keys-conversation" aria-label="この節へのリンク">#</a></h3>
<table>
<thead>
<tr><th>画面の項目名</th><th>Windows</th> <th>Mac</th>
</tr>
</thead>
<tbody>
<tr><td data-label="画面の項目名">「サイドバーの表示切り替え」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>B</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>B</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「キーボードショートカットを開く」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>,</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>,</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「セッションを続きから開く」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>P</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>P</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「タブ掃除を開く」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>K</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>K</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ダッシュボードを開く」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>G</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>G</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ダッシュボードの左の列へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>←</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>←</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ダッシュボードの右の列へ」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>→</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>→</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ダッシュボードの列を閉じる」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>Backspace</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>Backspace</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「ダッシュボードの列を固定」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>P</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>P</kbd></span></td>
</tr>
</tbody>
</table><h3 id="keys-settings">端末内を探し、入力する<a class="heading-anchor" href="#keys-settings" aria-label="この節へのリンク">#</a></h3>
<table>
<thead>
<tr><th>画面の項目名</th><th>Windows</th> <th>Mac</th>
</tr>
</thead>
<tbody>
<tr><td data-label="画面の項目名">「端末内を検索」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Shift</kbd><span class="key-join">+</span><kbd>F</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Shift</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>F</kbd></span></td>
</tr>
<tr><td data-label="画面の項目名">「タブの入力欄へ移動」</td><td data-label="Windows"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>Alt</kbd><span class="key-join">+</span><kbd>I</kbd></span></td> <td data-label="Mac"><span class="keys"><kbd>Alt</kbd><span class="key-join">+</span><kbd>Cmd</kbd><span class="key-join">+</span><kbd>I</kbd></span></td>
</tr>
</tbody>
</table><p>「左のタブへ」などの方向キーは、隣の表示場所にあるタブへ入力先を移します。「同じ場所の次のタブ」は、同じ表示場所に重なったタブを切り替えます。「並びの先頭に固定」は、この同じ場所の並びに作用します。</p><p>キー設定中に割り当てを外す操作は、<kbd>Backspace</kbd> か <kbd>Delete</kbd> です。これは上の 38 件とは別の、設定画面の編集操作です。</p>22:["$","section","shortcuts",{"id":"shortcuts","children":[["$","h2",null,{"children":["よく使うキー",["$","a",null,{"className":"heading-anchor","href":"#shortcuts","aria-label":"この節へのリンク","children":"#"}]]}],[],["$","nav",null,{"className":"section-jumps","aria-label":"よく使うキーの小見出し","children":[["$","a","keys-workspace",{"href":"#keys-workspace","children":"ワークスペースを作り、切り替える"}],["$","a","keys-panes",{"href":"#keys-panes","children":"タブと表示場所を操作する"}],["$","a","keys-conversation",{"href":"#keys-conversation","children":"一覧、会話と設定を開く"}],["$","a","keys-settings",{"href":"#keys-settings","children":"端末内を探し、入力する"}],["$","a","macos",{"href":"#macos","children":"macOS の窓とキーの違い"}]]}],[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$31"}}]]}],"$L32"]]}]
33:T1de3,<p>画面や本文の語を、用途ごとにまとめました。ページの検索でも探せます。</p><p><span id="glossary-list"></span></p><h3 id="glossary-place">画面と作業場所<a class="heading-anchor" href="#glossary-place" aria-label="この節へのリンク">#</a></h3>
<table class="two-column-table">
<thead>
<tr><th>語</th><th>意味</th></tr></thead>
<tbody>
<tr><td data-label="語">ワークスペース</td><td data-label="意味">案件や調査ごとに分ける作業場。サイドバーの 1 行です。</td></tr>
<tr><td data-label="語">表示場所</td><td data-label="意味">タブを並べるために画面を割った、1 つの場所です。</td></tr>
<tr><td data-label="語">タブ</td><td data-label="意味">端末の会話、Web、資料などの画面 1 つです。裏の端末でもプロセスは動き続けます。</td></tr>
<tr><td data-label="語">作業フォルダ</td><td data-label="意味">ワークスペースに結び付けたフォルダです。</td></tr>
<tr><td data-label="語">ランチャー</td><td data-label="意味">新しいタブに出る起動メニューです。</td></tr>
<tr>
<td data-label="語">Web タブ</td><td data-label="意味">ワークスペースに置くタブの一種です。ChatGPT などの Web サービスを開きます。</td></tr>
<tr><td data-label="語">裏のタブ</td><td data-label="意味">同じ表示場所に重ねてあり、いま画面に出ていないタブです。</td></tr>
<tr><td data-label="語">点線タブ</td><td data-label="意味">宣言だけして、まだプロセスを起こしていないタブです。</td></tr>
<tr><td data-label="語">ペット</td><td data-label="意味">ワークスペースに表示するキャラクターです。</td></tr>
<tr>
<td data-label="語">Buddy</td><td data-label="意味">エージェントの活動に合わせて話す、デスクトップのキャラクターです。</td></tr></tbody></table><h3 id="glossary-conversation">会話と引き継ぎ<a class="heading-anchor" href="#glossary-conversation" aria-label="この節へのリンク">#</a></h3>
<table class="two-column-table">
<thead>
<tr><th>語</th><th>意味</th></tr></thead>
<tbody>
<tr><td data-label="語">セッション</td><td data-label="意味">エージェントとのひと続きの会話です。</td></tr>
<tr><td data-label="語">セーブポイント</td><td data-label="意味">会話の要約、引き継ぎ書、復元情報をまとめたローカルの記録です。</td></tr>
<tr><td data-label="語">引き継ぎ書</td><td data-label="意味">次のエージェントが読む、作業の要点を記した文書です。</td></tr>
<tr><td data-label="語">受け渡しファイル</td><td data-label="意味">セーブポイント 1 件を渡す <code>.mycmux-transfer</code> ファイルです。</td></tr>
<tr>
<td data-label="語">Resume</td> <td data-label="意味"><span class="keys"><kbd>Ctrl</kbd><span class="key-join">+</span><kbd>P</kbd></span>（Mac は <span class="keys"><kbd>Cmd</kbd><span class="key-join">+</span><kbd>P</kbd></span>）で過去の会話を検索して開き直す機能です。</td></tr>
<tr>
<td data-label="語">crsm</td> <td data-label="意味">Resume と「続きから」が使うセッションの索引です。アプリに組み込まれていて、別に用意する必要はありません。</td></tr>
<tr><td data-label="語">ターンチップ</td><td data-label="意味">送った指示の位置をたどる操作部品です。</td></tr></tbody></table><h3 id="glossary-watch">一覧と見守り<a class="heading-anchor" href="#glossary-watch" aria-label="この節へのリンク">#</a></h3>
<table class="two-column-table">
<thead>
<tr><th>語</th><th>意味</th></tr></thead>
<tbody>
<tr><td data-label="語">ダッシュボード</td><td data-label="意味">全ワークスペースのセッションを一覧で見る画面です。</td></tr>
<tr><td data-label="語">可視タブ</td><td data-label="意味">委譲先を画面上で見える形にしたタブです。</td></tr>
<tr><td data-label="語">配置図</td><td data-label="意味">全ワークスペースの実際の並びを縮小した図です。</td></tr>
<tr><td data-label="語">計器行</td><td data-label="意味">一覧の行に出る、モデルやコンテキスト占有率などの情報です。</td></tr>
<tr><td data-label="語">質問カード</td><td data-label="意味">Claude Code の質問に、ダッシュボードから選択肢で答えるカードです。</td></tr>
<tr><td data-label="語">次の一手</td><td data-label="意味">選んだ会話に返す行動の候補です。</td></tr>
<tr><td data-label="語">受け取り箱</td><td data-label="意味">外部報告の通知の「開く」から、最近 20 件を読みます。</td></tr>
<tr><td data-label="語">気づきカード</td><td data-label="意味">ダッシュボードの「気づき」列に並ぶカードです。質問や未送信の入力など、確認が必要な事実を示します。</td></tr>
<tr><td data-label="語">実行契約カード</td><td data-label="意味">目的、素材、実行役、完了条件を 1 枚にして、「GO」まで何も動かさない仕組みです。</td></tr>
<tr><td data-label="語">見守り</td><td data-label="意味">動かしている委譲を定期的に巡回し、止まっているものを知らせる仕組みです。</td></tr>
<tr><td data-label="語">委譲</td><td data-label="意味">作業を別のエージェントへ渡すことです。</td></tr>
<tr><td data-label="語">会話列</td><td data-label="意味">ダッシュボードの中央に開く、会話ごとの縦の列です。1〜5 列まで並べられます。</td></tr></tbody></table><h3 id="glossary-config">設定と技術の語<a class="heading-anchor" href="#glossary-config" aria-label="この節へのリンク">#</a></h3>
<table class="two-column-table">
<thead>
<tr><th>語</th><th>意味</th></tr></thead>
<tbody>
<tr>
<td data-label="語">ailog</td><td data-label="意味">ローカルのログを索引して、使用量やコスト相当を見る機能です。</td></tr>
<tr>
<td data-label="語">effort</td><td data-label="意味">起動時に選ぶ、考える深さの設定です。</td></tr>
<tr><td data-label="語">コスト相当</td><td data-label="意味">ログと単価から出した金額です。請求額ではありません。</td></tr>
<tr>
<td data-label="語">PC 全体の CLI ログイン</td><td data-label="意味">同じ PC の CLI が使うログインです。アカウントの切り替えが作用します。</td></tr>
<tr>
<td data-label="語">CLI</td><td data-label="意味">端末でコマンドを入力して使うプログラムです。</td></tr>
<tr><td data-label="語">委譲 CLI</td><td data-label="意味">公開リポジトリの <code>scripts/mycmux_agent_cli.py</code>。起動、送信、読み取りのサブコマンドを持ちます。</td></tr>
<tr>
<td data-label="語">hook</td><td data-label="意味">エージェントが終了や質問などを mycmux に知らせる仕組みです。</td></tr>
<tr><td data-label="語">テストプロファイル</td><td data-label="意味"><code>--profile</code> で本番と分けて起動した mycmux です。</td></tr>
<tr><td data-label="語">更新の配布元（固定 feed）</td><td data-label="意味">更新の配布元として決めてあるリリースページです。</td></tr>
<tr>
<td data-label="語">ADR</td><td data-label="意味">設計の判断と理由を残す記録です。</td></tr></tbody></table>23:["$","section","glossary",{"id":"glossary","children":[["$","h2",null,{"children":["用語",["$","a",null,{"className":"heading-anchor","href":"#glossary","aria-label":"この節へのリンク","children":"#"}]]}],[],false,[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$33"}}]]}]]]}]
