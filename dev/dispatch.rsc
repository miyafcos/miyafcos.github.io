hildren":"子セッション"}]]}]]}],["$","g","spec",{"className":"node n-box","data-w":100,"data-id":"spec","children":[["$","rect",null,{"x":112,"y":14,"width":100,"height":44,"rx":8}],["$","text",null,{"x":162,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":162,"y":41.25,"className":"title","children":"spec を書く"}]]}]]}],["$","g","pre",{"className":"node n-box","data-w":100,"data-id":"pre","children":[["$","rect",null,{"x":112,"y":86,"width":100,"height":50,"rx":8}],["$","text",null,{"x":162,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":162,"y":116.25,"className":"title","children":"preflight"}]]}]]}],["$","g","spawn",{"className":"node n-accent","data-w":120,"data-id":"spawn","children":[["$","rect",null,{"x":232,"y":14,"width":120,"height":44,"rx":8}],["$","text",null,{"x":292,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":292,"y":41.25,"className":"title","children":"CLI で spawn"}]]}]]}],["$","g","led",{"className":"node n-box","data-w":100,"data-id":"led","children":[["$","rect",null,{"x":368,"y":14,"width":100,"height":44,"rx":8}],["$","text",null,{"x":418,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":418,"y":41.25,"className":"title","children":"台帳に記録"}]]}]]}],["$","g","close",{"className":"node n-box","data-w":144,"data-id":"close","children":[["$","rect",null,{"x":576,"y":8,"width":144,"height":56,"rx":8}],["$","text",null,{"x":648,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":648,"y":29.75,"className":"title","children":"close-tab・"}],"$L25"]}]]}],"$L26","$L27","$L28","$L29","$L2a"],"$undefined"]}],"$undefined","$L2b","$L2c"]}],"$L2d"]
2e:T893,<p>台帳は、委譲タスク 1 件につき 1 ペインの起動を記録するファイルです。書き込むのは <code>dispatch_ledger.py</code> だけで、手で追記することは禁じられています。調査時点で 1,330 行、453 件ありました。</p>
<table>
<thead>
<tr><th>項目</th><th>決まり</th><th>根拠</th></tr></thead>
<tbody>
<tr><td>委譲タスクの見分け方</td><td><code>(slug, tab_session_id)</code> の組。slug が同じでも、別の委譲タスクは混ぜない</td><td><code>~/.claude/skills/session-dispatch/scripts/dispatch_ledger.py:10-12</code></td>
</tr>
<tr>
<td>slug の形</td><td><code>YYMMDD-&lt;名前&gt;</code> が必須</td><td><code>~/.claude/skills/session-dispatch/scripts/dispatch_ledger.py:237-243</code></td>
</tr>
<tr><td>状態の語彙</td><td>進行中は open、running、blocked。完了は done、close_failed。閉じたものは closed、done-verified-closed、abandoned、fallback-inline。非活性は、閉じたものと lost</td> <td><code>~/.claude/skills/session-dispatch/scripts/dispatch_ledger.py:31-57</code></td>
</tr>
<tr><td>更新の宛先</td><td>spawn の時刻より tab_session_id を信じ、どの委譲タスクにも当たらない更新は拒む。9 月上旬の「幽霊の委譲タスク」事故の再発防止</td><td><code>~/.claude/skills/session-dispatch/scripts/dispatch_ledger.py:276-305</code></td>
</tr>
</tbody>
</table><p>直近 7 日の新規は 119 件で、調査当日だけで 76 件でした。宛先は Claude 60、Codex 29、記録なし 30（コマンドを直接渡して立てたもの）です。</p><div class="callout warn"><p>台帳と実物がずれています。台帳で進行中の 45 件のうち、ペインが実在するのは 16 件でした（調査当日の夕方に照合）。残る 29 件は、ペインが消えたのに進行中のままです。</p><p>以前は見張りが lost を付けていましたが、9 月中旬に止めてからは付ける仕組みがありません。アプリの委譲の見守りは、消えたペインの行（abandonedSlugs）を計算しているのに、その結果を使っていません。</p></div>19:["$","section","ledger",{"id":"ledger","children":[["$","h2",null,{"children":"台帳 ledger.jsonl"}],[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$2e"}}]]]}]
1a:["$","section","send",{"id":"send","children":[["$","h2",null,{"children":"追加指示の送信"}],[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p><code>dispatch_send.py</code> は、次の順で子セッションに指示を届けます。自動の再送はしません。</p>\n<ol><li>宛先を台帳から 1 件に絞り、その tab_session_id を使う。閉じた委譲タスクなら送らない</li><li>アプリの <code>session.state_view</code> から、期待値 4 点（epoch、attention id、セッション改訂番号、入力改訂番号）を取る</li><li>既定では、子セッションに attention が付いていないことを求める</li><li>本文を入れ、自分の入力で進んだ入力改訂番号を追ってから、Enter を 1 回送る。期待値が一部しかないと、アプリ側が <code>incomplete_expectations</code> で拒否する（<code>src/components/layout/socketCommands.ts:2053-2057</code>）</li><li>Enter のあと 20 秒間、入力欄が空になり、状態か transcript が動くかを見る</li><li>確かめられなければ、<code>guard/pending_sends.jsonl</code> に「見張りに任せる」として登録する</li></ol><p>送信の結果として分かるのは「配送を観測できた」ところまでで、子セッションが指示を実行した証明にはなりません。確かめられなかった送信の登録は調査時点で 123 行あり、未解決のまま 51 セッション分が残っています。見張りが止まっているので、この登録を拾う仕組みはありません。</p>"}}]]]}]
1b:["$","section","collect",{"id":"collect","children":[["$","h2",null,{"children":"完了の回収"}],[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<div class=\"cards\"><div class=\"card\"><h3 class=\"card-t\">dispatch_watch（自動検収）</h3><p>DONE.md を見つけると spec の検収ブロックを実行し、全部通れば close-tab して台帳を閉じます。固定名の spec.md と DONE.md しか見ないため、1 フォルダに複数レーンを置く委譲タスクには使えません。VERDICT.md は直近 7 日で 6 件でした。</p></div><div class=\"card\"><h3 class=\"card-t\">dispatch_status（状況表示）</h3><p>子セッションの Claude の transcript 1 本の更新時刻で、「動いている / 止まっている」を決めます。Codex の子セッションや、専用 worktree の子セッションは読めません。157 行中 97 行が UNKNOWN で、うち 95 行は Claude のプロジェクトフォルダがないものでした。</p></div><div class=\"card pick\"><h3 class=\"card-t\">実運用: 親の自作ポーリング</h3><p>委譲タスクのフォルダに <code>wait_done.py</code>、<code>poll_status.py</code>、<code>poll_seat.py</code> などを置き、DONE の出現、画面の質問、使用量上限を見て止まります。委譲タスクごとに書き直しています。</p></div></div>"}}]]]}]
1c:["$","section","ask-card",{"id":"ask-card","children":[["$","h2",null,{"children":"判断カード"}],[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>判断カードは、実行中の子セッションが人の判断を求めるための、唯一の正規の経路です。子セッションが自分で <code>AskUserQuestion</code>（Claude Code の選択式の質問ツール）を出すと、質問は親に届かず、画面で止まってしまいます。そこで hook でこの呼び出しを止め、カードに回します。</p>"}}],["$","figure","1",{"className":"fig","data-fig":"F16","children":[["$","svg",null,{"className":"fig-wide","viewBox":"0 0 720 215","width":"100%","role":"img","aria-label":"子セッションが人に聞きたいときは、画面の質問を hook が止め、カードとしてキューに積む。親セッションの次の発言でカードが差し込まれ、作者の判断が子セッションへ送り返される。","data-vw":720,"data-fs":15,"xmlns":"http://www.w3.org/2000/svg","children":[["$","title",null,{"children":"子セッションが人に聞きたいときは、画面の質問を hook が止め、カードとしてキューに積む。親セッションの次の発言でカードが差し込まれ、作者の判断が子セッションへ送り返される。"}],["$","defs",null,{"children":[["$","marker",null,{"id":"F16-wide-arrow","viewBox":"0 0 10 10","refX":"9","refY":"5","markerWidth":"8","markerHeight":"8","orient":"auto-start-reverse","children":["$","path",null,{"d":"M0 0L10 5L0 10z","className":"arrowhead"}]}],["$","marker",null,{"id":"F16-wide-arrow-accent","viewBox":"0 0 10 10","refX":"9","refY":"5","markerWidth":"8","markerHeight":"8","orient":"auto-start-reverse","children":["$","path",null,{"d":"M0 0L10 5L0 10z","className":"arrowhead accent"}]}]]}],[["$","g","0",{"children":[["$","path",null,{"d":"M220 32L260 32","className":"edge","markerEnd":"url(#F16-wide-arrow)","markerStart":"$undefined"}],"$undefined"]}],["$","g","1",{"children":[["$","path",null,{"d":"M460 32L500 32","className":"edge","markerEnd":"url(#F16-wide-arrow)","markerStart":"$undefined"}],"$undefined"]}],["$","g","2",{"children":[["$","path",null,{"d":"M600 64L600 87L120 87L120 110","className":"edge","markerEnd":"url(#F16-wide-arrow)","markerStart":"$undefined"}],"$undefined"]}],["$","g","3",{"children":[["$","path",null,{"d":"M220 142L260 142","className":"edge","markerEnd":"url(#F16-wide-arrow)","markerStart":"$undefined"}],"$undefined"]}],["$","g","4",{"children":[["$","path",null,{"d":"M460 142L500 142","className":"edge","markerEnd":"url(#F16-wide-arrow)","markerStart":"$undefined"}],"$undefined"]}]],[["$","g","s1",{"className":"node n-box","data-w":200,"data-id":"s1","children":[["$","rect",null,{"x":20,"y":0,"width":200,"height":64,"rx":8}],["$","text",null,{"x":120,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":120,"y":25.75,"className":"title","children":"Step 1"}],["$","tspan","1",{"x":120,"y":48.75,"className":"sub","children":"子が AskUserQuestion"}]]}]]}],["$","g","s2",{"className":"node n-box","data-w":200,"data-id":"s2","children":[["$","rect",null,{"x":260,"y":0,"width":200,"height":64,"rx":8}],["$","text",null,{"x":360,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":360,"y":25.75,"className":"title","children":"✕ 遮断"}],["$","tspan","1",{"x":360,"y":48.75,"className":"sub","children":"child-guard が拒否"}]]}]]}],["$","g","s3",{"className":"node n-box","data-w":200,"data-id":"s3","children":[["$","rect",null,{"x":500,"y":0,"width":200,"height":64,"rx":8}],["$","text",null,{"x":600,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":600,"y":25.75,"className":"title","children":"Step 3"}],["$","tspan","1",{"x":600,"y":48.75,"className":"sub","children":"card.json とキュー"}]]}]]}],["$","g","s4",{"className":"node n-box","data-w":200,"data-id":"s4","children":[["$","rect",null,{"x":20,"y":110,"width":200,"height":64,"rx":8}],["$","text",null,{"x":120,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":120,"y":135.75,"className":"title","children":"Step 4"}],["$","tspan","1",{"x":120,"y":158.75,"className":"sub","children":"ask-inject が親へ"}]]}]]}],["$","g","s5",{"className":"node n-accent","data-w":200,"data-id":"s5","children":[["$","rect",null,{"x":260,"y":110,"width":200,"height":64,"rx":8}],["$","text",null,{"x":360,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":360,"y":135.75,"className":"title","children":"★ 判断"}],["$","tspan","1",{"x":360,"y":158.75,"className":"sub","children":"作者が判断"}]]}]]}],["$","g","s6",{"className":"node n-box","data-w":200,"data-id":"s6","children":[["$","rect",null,{"x":500,"y":110,"width":200,"height":64,"rx":8}],["$","text",null,{"x":600,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":600,"y":135.75,"className":"title","children":"Step 6"}],["$","tspan","1",{"x":600,"y":158.75,"className":"sub","children":"answer-ask で子へ"}]]}]]}]],["$","g",null,{"children":[["$","path",null,{"d":"M700 142L712 142L712 200L8 200L8 32L20 32","className":"edge accent","markerEnd":"url(#F16-wide-arrow-accent)"}],["$","g",null,{"className":"edge-label-group","children":[["$","rect",null,{"x":324,"y":188.75,"width":72,"height":22.5,"rx":4,"className":"edge-label-bg"}],["$","text",null,{"x":360,"y":205.25,"textAnchor":"middle","fontSize":15,"className":"edge-label","children":"子が再開"}]]}]]}]]}],"$undefined",["$","svg",null,{"className":"fig-narrow","viewBox":"0 0 350 460","width":"100%","role":"img","aria-label":"子セッションが人に聞きたいときは、画面の質問を hook が止め、カードとしてキューに積む。親セッションの次の発言でカードが差し込まれ、作者の判断が子セッションへ送り返される。","data-vw":350,"data-fs":15,"xmlns":"http://www.w3.org/2000/svg","children":[["$","title",null,{"children":"子セッションが人に聞きたいときは、画面の質問を hook が止め、カードとしてキューに積む。親セッションの次の発言でカードが差し込まれ、作者の判断が子セッションへ送り返される。"}],"$L2f",["$L30","$L31","$L32","$L33","$L34"],["$L35","$L36","$L37","$L38","$L39","$L3a"],"$L3b"]}],"$L3c"]}],"$L3d"]]}]
3e:T853,<p>見張りは、子セッションや手動で立てたエージェントのペインが黙って止まるのを検出し、回復させるか通報する常駐プロセスです。止まる原因として、起動時の確認、入力欄に残った本文、質問、承認、ログインを見ます。9 月上旬に導入し、9 月中旬に止めました。</p>
<table>
<thead>
<tr><th>止め方</th><th>中身</th></tr></thead>
<tbody>
<tr>
<td>DISABLED ファイル</td><td><code>~/.claude/dispatch/guard/DISABLED</code>（9 月中旬）。止めた理由が 2 つ書いてある。「カードが雑音だった」と「カードに答えると回答文が無関係なペインに打ち込まれた」で、再開の手順も書いてある</td></tr>
<tr><td>ユーザー環境変数</td><td><code>MYCMUX_DISPATCH_GUARD=off</code>。ランチャーが見張りを起こすのを止める</td></tr>
<tr><td>スケジュールタスク</td><td><code>ClaudeOps-DispatchGuard</code> は 9 月上旬から無効。10 分ごとの起動を 2,204 回飛ばしている</td></tr></tbody></table><p>止める前の見張りは、15 秒ごとに画面を 40 行読み、13 種類に分類していました。対象は、Claude、Codex、Grok の全ペインと、台帳にある子セッションです。処置は、キー送出、推奨の選択肢での回答、承認の拒否、催促、lost の付与、通報でした。通報の記録は 1,150 行（9 月上旬から中旬）あり、そのうち 879 行は「ペインが消えた」です。</p><div class="callout warn"><p>止めたあとも、<code>dispatch_send.py</code>、<code>dispatch_preflight.py</code>、<code>dispatch_watch.py</code> が見張りの <code>ensure()</code> を関数として直接呼んでいます。そのたびに見張りのプロセスが立ち上がり、DISABLED を見てすぐ終了して、guard.log に 1 行残します。調査時点で 165 行ありました。開発の記録にある「9 月上旬に dry-run で停止」は古い記述で、9 月中旬に止める直前は本番モードで動いていました。</p></div>1d:["$","section","guard",{"id":"guard","children":[["$","h2",null,{"children":"見張り dispatch_guard（停止中）"}],[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$3e"}}]]]}]
3f:T87a,<p>設定画面の「委譲の見守り」は、Rust の dispatch モジュールが受け持つ機能です。主窓が見えている間は 10 分ごとに skill の台帳を読み、質問待ち、完了未確認、停滞をトーストで知らせます。送信も片付けもしません（契約テスト <code>tests/test_dispatch_watchdog_contract.py:28-36</code>）。担当する窓は、台帳の置き場に書く <code>.watchdog.lock</code> で 1 つに決めます。</p><p>ただし台帳の読み方が、skill の決まりと 3 点で食い違っています。</p>
<table>
<thead>
<tr><th>食い違い</th><th>アプリの読み方</th><th>skill の決まり</th></tr></thead>
<tbody>
<tr><td>委譲タスクのまとめ方</td><td>slug ごとに、行を後勝ちで重ねる（<code>src-tauri/src/dispatch/ledger.rs:54-72</code>）。経過時間も、最後の行の時刻から測る</td><td>slug が同じでも、別の委譲タスクは混ぜない（8 月中旬に改めた）</td></tr>
<tr><td>動いているかの判定</td><td>作業フォルダに対応する Claude のプロジェクトフォルダの、最新の jsonl の年齢（<code>src-tauri/src/dispatch/ledger.rs:74-92</code>）</td><td>親や兄弟の活動と取り違えるので廃止（<code>~/.claude/skills/session-dispatch/scripts/dispatch_status.py:5-7</code>）</td></tr>
<tr><td>完了と質問のファイル</td><td>固定名の <code>DONE.md</code>、<code>ASK.md</code>、<code>VERDICT.md</code> だけを見る（<code>src-tauri/src/dispatch/ledger.rs:117-119</code>）</td><td>完了は、レーン名付きの DONE が過半。質問はカード（ops キュー）で、ASK.md は 9 月中旬を最後に使われていない</td></tr></tbody></table><p>トーストになるのは、「質問あり（ASK.md）」「検収で不合格」「入力が残ったまま」の 3 種類だけです。調査当日の例のように、Codex の子セッションが専用 worktree を使う委譲タスクもあります。その場合は「ログなし」のまま 3 時間たつと timeout になりますが、この timeout はトーストになりません。</p>1e:["$","section","watchdog",{"id":"watchdog","children":[["$","h2",null,{"children":"アプリ側: 委譲の見守り"}],[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$3f"}}]]]}]
1f:["$","section","workorder",{"id":"workorder","children":[["$","h2",null,{"children":"アプリ側: WorkOrder と自動化スイッチ"}],[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>WorkOrder は、契約カードから統合役のペインを 1 本立てる仕組みです。契約カードは、ダッシュボードの入力欄で 2 つ以上のペインを @ で指し、「まとめる・統合する・比較する」と書くと出ます。材料役のペインの要約を集め、git worktree を用意し、計画を封印（seal）してから、socket と同じ <code>pane.spawn_tab</code> を呼びます（<code>src-tauri/src/workorder/executor.rs:180-236</code>）。</p><p>コードは端から端までつながっていますが、<code>~/.mycmux/workorders.db</code> にあるのは 8 月中旬の下書き 1 件だけで、GO（実行）は一度もありません。この DB は 192MB ありますが、中身の大半は別の機能の観測台帳です（<code>agent_state_ledger</code> 93,924 行、<code>agent_state_observations</code> 94,374 行）。</p><p>設定の「自動化」タブにある 2 つのスイッチ（自動で次へ進む、注意カード）は、既定値のまま一度も保存されていません。この「注意カード」はアプリのカードのスイッチで、skill の判断カードとは関係ありません。</p>"}}]]]}]
