tle","children":"CLI で spawn"}]]}]]}],["$","g","l2",{"className":"node n-group","data-w":350,"data-id":"l2","children":[["$","rect",null,{"x":0,"y":176,"width":350,"height":96,"rx":8}],["$","text",null,{"x":12,"textAnchor":"start","fontSize":15,"children":[["$","tspan","0",{"x":12,"y":200.75,"className":"title","children":"アプリ"}]]}]]}],["$","g","lau",{"className":"node n-box","data-w":158,"data-id":"lau","children":[["$","rect",null,{"x":12,"y":216,"width":158,"height":44,"rx":8}],["$","text",null,{"x":91,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":91,"y":243.25,"className":"title","children":"ランチャーで起動"}]]}]]}],["$","g","pane",{"className":"node n-box","data-w":158,"data-id":"pane","children":[["$","rect",null,{"x":180,"y":216,"width":158,"height":44,"rx":8}],["$","text",null,{"x":259,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":259,"y":243.25,"className":"title","children":"pane.spawn_tab"}]]}]]}],["$","g","l3",{"className":"node n-group","data-w":350,"data-id":"l3","children":[["$","rect",null,{"x":0,"y":290,"width":350,"height":96,"rx":8}],["$","text",null,{"x":12,"textAnchor":"start","fontSize":15,"children":[["$","tspan","0",{"x":12,"y":314.75,"className":"title","children":"子セッション"}]]}]]}],["$","g","work",{"className":"node n-box","data-w":158,"data-id":"work","children":[["$","rect",null,{"x":12,"y":330,"width":158,"height":44,"rx":8}],["$","text",null,{"x":91,"textAnchor":"middle","fontSize":15,"children":[["$","tspan","0",{"x":91,"y":357.25,"className":"title","children":"spec を読んで作業"}]]}]]}],"$L44","$L45","$L46","$L47"],"$undefined"]}]
2c:["$","figcaption",null,{"children":[["$","span",null,{"className":"fig-no","children":"図 1"}],"委譲タスクは session-dispatch が組み立て、アプリは spawn、send、close の機能を貸すだけです。子セッションが完了を報告したら、親セッションが成果物を確かめてから閉じます。"]}]
48:T12f1,<p>「CLI で spawn」の枠が、skill がアプリの機能（socket）を使い始める境目です。</p><ol class="steps"><li class="done">振り分け</li><li class="done">spec を書く</li><li class="done">preflight</li><li class="done">spawn</li><li class="done">台帳に記録</li><li class="now">作業と追加指示</li><li>完了の回収</li><li>片付け</li></ol>
<p>振り分けは、session-dispatch skill の判定表で決めます（<code>~/.claude/skills/session-dispatch/SKILL.md:22-34</code>）。選択肢は「親のまま」「Codex に委譲」「新しいペインの Claude」「分割（上限 3 本）」「Agent ツール」の 5 つです。新しいペインを使うと決めたら、次の順に進みます。</p>
<ol>
<li><strong>spec（子セッションへの最初の指示書）を書く</strong>。置き場は委譲タスクのフォルダ <code>~/.claude/dispatch/&lt;YYMMDD&gt;-&lt;名前&gt;/</code> です。必須項目は、変更してよい範囲、完了の条件、接続先、判断者と完了報告（DONE）の約束、判断カードの約束の 5 つです（skill の <code>references/spec-template.md:8-54</code>）</li><li><strong>preflight を走らせる</strong>。子の作業フォルダを信頼済みにし、MCP 2 つ（相談用の MCP と deepwiki）を <code>~/.claude.json</code> に書きます。外部サービスの経路も確かめます（<code>~/.claude/skills/session-dispatch/scripts/dispatch_preflight.py:28-72</code>）。最後に見張りの <code>ensure()</code> を呼びますが、見張りは止まっているので空振りします</li><li><strong>spawn する</strong>。<code>mycmux_agent_cli.py spawn --target claude --prompt-file &lt;spec&gt; --label &lt;名前&gt; --no-activate</code> を使います。既定では呼び出し元と同じタブの裏ペインになり、別のタブに分けたいときだけ <code>--split</code> を付けます（<code>scripts/mycmux_agent_cli.py:478-497</code>）</li><li><strong>台帳に記録する</strong>。<code>dispatch_ledger.py append</code> が、spawn の応答の <code>sessionId</code> を <code>tab_session_id</code> に写します。<code>tab_session_id</code> はそのペインの PTY セッション ID で、送信と片付けの宛先になります。直近 7 日の 119 件すべてに、この値が入っています</li><li><strong>作業と追加指示</strong>。追加の指示は <code>dispatch_send.py</code> で送ります（後述）</li><li><strong>完了の回収</strong>。子セッションは <code>DONE*.md</code> を書きます。親はその自己申告を鵜呑みにせず、成果物を自分で確かめます</li><li><strong>片付け</strong>。<code>close-tab --session &lt;tab_session_id&gt;</code> でペインを閉じ、台帳を <code>closed</code> にします</li></ol><h3>実例: 調査当日の 1 フォルダ 3 件</h3><p>調査当日のある委譲タスクのフォルダには、3 件（openwith、perf1、perf2）が入っていました。子セッションはすべて Codex で、作業フォルダはそれぞれ専用の git worktree です。記録の形だけを時刻順に並べます。</p><ul class="timeline"><li><b>12:59</b> 親が <code>spec_openwith.md</code> と <code>prompt_openwith.txt</code>（spec を全文読めという英文 1 行）を書き、spawn の応答を <code>spawn_openwith.json</code> に保存</li><li><b>13:00</b> 台帳に openwith の行が入る。target は <code>codex</code> で、model（GPT-6 世代）と effort（xhigh）は記録されるだけ</li><li><b>14:08</b> 子が <code>DONE_openwith.md</code> を書く</li><li><b>14:17</b> 親が差し戻しの <code>spec_openwith_fix1.md</code> を書く（どう届けたかは記録から追えない）</li><li><b>14:28</b> 台帳の openwith を closed にする</li><li><b>17:37</b> 子が <code>DONE_perf1.md</code> を書く。アプリの編集保存が .bak を 2 本残す</li><li class="now"><b>17:40</b> 親が <code>STATUS.md</code>（現在地のメモ）を書き、perf2 を open にする。17:44 に待ち受け用の <code>poll_seat.py</code> を置く</li></ul>
<p>この例では、自動検収の VERDICT.md も判断カードも作られていません。親は watcher を使わず、委譲タスクごとに待ち受けのスクリプト（<code>wait_done.py</code>、<code>poll_status.py</code>、<code>poll_seat.py</code>）を書き直しています。</p><p>手順書（SKILL.md）は、「1 フォルダに 1 件、ファイル名は固定の spec.md と DONE.md」を前提にしています。実際の運用では 1 フォルダに複数のレーンを置き、ファイル名にレーン名を付けています。直近 7 日の DONE 96 件のうち、固定名の DONE.md は 44 件だけでした。</p>2d:["$","div","1",{"dangerouslySetInnerHTML":{"__html":"$48"}}]
