43:T844,<table class="two-column-table">
<thead>
<tr><th>ページ</th><th>読む内容</th></tr></thead>
<tbody>
<tr><td data-label="ページ"><a href="/dev/boundary">境界</a></td><td data-label="読む内容">制御 API、hook、環境変数、同梱の手順です。</td></tr>
<tr><td data-label="ページ"><a href="/dev/editor">エディタ本体</a></td><td data-label="読む内容">型、端末の出力、保存、配置、窓と Web です。</td></tr>
<tr><td data-label="ページ"><a href="/dev/observation">観測とカード</a></td><td data-label="読む内容">状態の根拠、画面の表示、人が応じる操作です。</td></tr>
<tr><td data-label="ページ"><a href="/dev/dispatch">ディスパッチ</a></td><td data-label="読む内容">起動、送信、引き継ぎと結果の確認です。</td></tr>
<tr><td data-label="ページ"><a href="/dev/resume">再開</a></td><td data-label="読む内容">会話の対応、復元、再開と休止です。</td></tr>
<tr><td data-label="ページ"><a href="/dev/house">エージェントの家</a></td><td data-label="読む内容">未実装の設計と、使える機能の違いです。</td></tr>
<tr><td data-label="ページ"><a href="/dev/subsystems">周辺の仕組み</a></td><td data-label="読む内容">使用量、ログ、保存記録、再配置と点検です。</td></tr>
<tr><td data-label="ページ"><a href="/dev/runtime">いま動いているもの</a></td><td data-label="読む内容">ソース上の処理、保存先と実機確認の境界です。</td></tr>
<tr><td data-label="ページ"><a href="/dev/plans">設計文書と実装</a></td><td data-label="読む内容">文書の判断と、配布版にある実装の照合です。</td></tr>
<tr><td data-label="ページ"><a href="/dev/responsibility">立ち位置と約束</a></td><td data-label="読む内容">責務、識別子、操作の結果と制限です。</td></tr>
<tr><td data-label="ページ"><a href="/dev/glossary">用語</a></td><td data-label="読む内容">画面の呼び名と、変えていない API 名です。</td></tr></tbody></table>27:["$","section","pages",{"id":"pages","children":[["$","h2",null,{"children":["ページの一覧",["$","a",null,{"className":"heading-anchor","href":"#pages","aria-label":"この節へのリンク","children":"#"}]]}],[],false,[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"$43"}}]]}]]]}]
28:["$","section","status",{"id":"status","children":[["$","h2",null,{"children":["主な仕組み",["$","a",null,{"className":"heading-anchor","href":"#status","aria-label":"この節へのリンク","children":"#"}]]}],[],false,[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<table class=\"two-column-table\">\n<thead>\n<tr><th>仕組み</th><th>確かめられること</th></tr></thead>\n<tbody>\n<tr><td data-label=\"仕組み\">タブと窓</td><td data-label=\"確かめられること\">動いたまま移し、保存した窓の配置を復元します。</td></tr>\n<tr><td data-label=\"仕組み\">制御 API と CLI</td><td data-label=\"確かめられること\">版と能力を照会し、起動、状態、送信、読取、終了を扱います。</td></tr>\n<tr>\n<td data-label=\"仕組み\">CLI の全件の <code>status</code></td><td data-label=\"確かめられること\">入力改訂番号の <code>null</code> を許します。送信の期待値には使いません。</td></tr>\n<tr><td data-label=\"仕組み\">会話履歴</td><td data-label=\"確かめられること\">Claude Code と Codex の全過去をページごとに読みます。</td></tr>\n<tr><td data-label=\"仕組み\">受け取り箱</td><td data-label=\"確かめられること\">外部報告の最近 20 件を読む入口です。</td></tr>\n<tr><td data-label=\"仕組み\">エージェント設計</td><td data-label=\"確かめられること\">設定の本文、比較、点検と HTML の書き出しです。</td></tr></tbody></table>"}}]]}]]]}]
29:["$","section","screen",{"id":"screen","children":[["$","h2",null,{"children":["画面と本文を対応させる",["$","a",null,{"className":"heading-anchor","href":"#screen","aria-label":"この節へのリンク","children":"#"}]]}],[],false,[["$","div","0",{"children":[["$","div","0",{"dangerouslySetInnerHTML":{"__html":"<p>画面 1 つはタブ、画面を割った場所は表示場所です。コードの <code>Pane</code>、<code>PaneTab</code>、API の <code>pane.*</code> は名前を変えていません。<a href=\"/dev/editor#model\">型と画面の対応</a>で、それぞれの意味を確認できます。</p>"}}]]}]]]}]
