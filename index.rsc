1:["$","main",null,{"className":"site-main product-home","id":"main","children":[["$","section",null,{"className":"product-hero","children":[["$","p",null,{"className":"eyebrow","children":"Windows と Mac で動くオープンソースのアプリ"}],["$","h1",null,{"children":[["$","span",null,{"children":"ターミナルを、"}],["$","span",null,{"children":["$","em",null,{"children":"マウスで広げる"}]}]]}],["$","div",null,{"className":"hero-copy","dangerouslySetInnerHTML":{"__html":"<p>mycmux は、いつものターミナルに、Claude Code や Codex を並べて動かす道具を足します。起動から分割、ペインの切り替え、窓への切り離しまで、マウスで操作できます。ランチャーではモデルと effort も選べます。</p>"}}],["$","$Lf",null,{}]]}],["$","section",null,{"className":"demo-section","id":"scenes","aria-label":"ターミナルから、少しずつ広げる","children":["$","$L10",null,{"scenes":[{"title":"ターミナル","description":"はじめは、ひとつのシェル。見慣れたプロンプトから、いつものコマンドを実行できます。"},{"title":"ランチャー","description":"アイコンからエージェントを起動。「…」を開けば、モデルと effort をチップで選べます。"},{"title":"分割","description":"タブを左右・上下に分け、区切り線をドラッグして広さを調整できます。"},{"title":"タブとペイン","description":"ひとつのタブに複数のペインを置けます。つまみで切り替え、ドラッグで別のタブへ移せます。"},{"title":"窓に切り離す","description":"ペインを窓の外へドラッグ。中身だけの窓に切り離して、好きな位置に置けます。"},{"title":"エージェントを並べる","description":"Claude Code と Codex を並べて作業。左の一覧を開き、返事を待つ「要回答」に気づけます。"}]}]}],["$","section",null,{"className":"product-section agent-section","id":"agents","data-reveal":true,"children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"section-index","children":"対応するエージェント"}],["$","h2",null,{"children":"いつものエージェントを、そのまま"}]]}],["$","div",null,{"className":"section-lead","dangerouslySetInnerHTML":{"__html":"<p>エージェントは別に入れて、普段の端末から起動できるようにしておきます。</p>"}}],["$","div",null,{"className":"agent-groups","children":[["$","div","ターミナルで動くもの",{"className":"agent-group","children":[["$","h3",null,{"children":[["$","span",null,{"aria-hidden":"true","children":">_"}],"ターミナルで動くもの"]}],["$","div",null,{"className":"agent-chips","dangerouslySetInnerHTML":{"__html":"<ul>\n<li>Claude Code</li> <li>Codex</li> <li>claude-codex</li> <li>Grok Build</li> <li>Antigravity (agy)</li> <li>Hermes</li> <li>Oh My Pi</li>\n</ul>"}}]]}],["$","div","Web ペインで開くもの",{"className":"agent-group","children":[["$","h3",null,{"children":[["$","span",null,{"aria-hidden":"true","children":"◎"}],"Web ペインで開くもの"]}],["$","div",null,{"className":"agent-chips","dangerouslySetInnerHTML":{"__html":"<ul>\n<li>ChatGPT (Web)</li> <li>Gemini (Web)</li> <li>Grok (Web)</li> <li>Claude.ai (Web)</li> <li>NotebookLM (Web)</li> <li>Browser (Web)</li>\n</ul>"}}]]}]]}]]}],["$","section",null,{"className":"product-section","id":"benefits","children":[["$","div",null,{"className":"section-heading","data-reveal":true,"children":[["$","p",null,{"className":"section-index","children":"毎日の作業で"}],["$","h2",null,{"children":"作業場の中でできること"}]]}],["$","$L11",null,{"cards":[{"title":"案件ごとに、作業場を分ける","html":"<p>案件や調査ごとにワークスペースを分け、左の一覧から切り替えます。</p><p><a href=\"/guide/screen#workspace\">作業場の使い方</a></p>","shot":{"file":"/shots/top-01_home-empty.png","alt":"作業場 report-tool の一覧と Claude Code のペイン","caption":"初回の画面です。「フォルダを選んで開始」から作業フォルダを選べます。","width":608,"height":342,"size":"wide","page":"start","section":"first-ten","scene":"初回の画面と作成方法を選ぶボタン","source":"assets-src/shots/full-02_workspace-overview.png","sourceWidth":3840,"sourceHeight":2160,"crop":{"x":0,"y":60,"width":608,"height":342},"sourceSha256":"95a3d886d082e44aaf8d0117b70e9590e73e9e673b1967dca706d871d5de321f","fileSha256":"222d61a0993317b6611ff8d3d2affc2800747a70c8fe8fc28bb8762278732c6d","operation":"crop only; downscale-only display; no upscale, retouch or repaint"},"recording":{"poster":"/videos/01_home-empty.jpg","sources":[{"src":"/videos/01_home-empty.webm","type":"video/webm"},{"src":"/videos/01_home-empty.mp4","type":"video/mp4"}]}},{"title":"読み込むときは、大きく","html":"<p>並べたタブのひとつを拡大して、指摘や差分に集中できます。</p><p><a href=\"/guide/screen#workspace\">タブの分割と拡大</a></p>","shot":{"file":"/shots/top-15_pane-split-zoom.png","alt":"拡大した Claude Code のペインと確認結果","caption":"Claude Code のタブだけを拡大しています。同じ操作で元の並びへ戻ります。","width":896,"height":504,"size":"content","page":"guide-screen","section":"workspace","scene":"全面に拡大した Claude Code のタブ","source":"assets-src/shots/full-15_pane-split-zoom.png","sourceWidth":3840,"sourceHeight":2160,"crop":{"x":0,"y":0,"width":896,"height":504},"sourceSha256":"84673f813c7bb246dfafedd485b9dea5afc1d21d9fe4ece99160c3fb36c186fe","fileSha256":"b84e46f5f7086c89a0df53f22529cfa97f42ac7d45e95ac371f9c78d8782d2d2","operation":"crop only; downscale-only display; no upscale, retouch or repaint"},"recording":{"poster":"/videos/15_pane-split-zoom.jpg","sources":[{"src":"/videos/15_pane-split-zoom.webm","type":"video/webm"},{"src":"/videos/15_pane-split-zoom.mp4","type":"video/mp4"}]}},{"title":"ペインを切り替えても続く","html":"<p>同じタブにペインを追加できます。裏にあるペインでも、作業は動き続けます。</p><p><a href=\"/guide/screen#workspace\">ペインの使い方</a></p>","shot":{"file":"/shots/top-05_pane-tabs.png","alt":"Claude Code のタブと裏のペインの印","caption":"Claude Code の横に、アイコンに畳まれたペインが並んでいます。","width":576,"height":324,"size":"content","page":"guide-screen","section":"terminal","scene":"Claude Code のペインとアイコンに畳まれたペインの帯","source":"assets-src/shots/full-05_pane-tabs.png","sourceWidth":3840,"sourceHeight":2160,"crop":{"x":576,"y":64,"width":576,"height":324},"sourceSha256":"e3b6fa49e604ed20ff67df1395578541fa832491290ca3812899ae9281d9f9d7","fileSha256":"21510264dc0ef61c4b1dcb4a851b0d68554fbf43e607385a686e37823c2982cc","operation":"crop only; downscale-only display; no upscale, retouch or repaint"},"recording":{"poster":"/videos/05_pane-tabs.jpg","sources":[{"src":"/videos/05_pane-tabs.webm","type":"video/webm"},{"src":"/videos/05_pane-tabs.mp4","type":"video/mp4"}]}},{"title":"送った指示に戻って読み返す","html":"<p>会話履歴から指示を選び、前のやり取りを読み返せます。</p><p><a href=\"/guide/screen#terminal\">会話をたどる</a></p>","shot":{"file":"/shots/top-14_turnchip.png","alt":"会話履歴の操作部と送った指示の一覧","caption":"出力を遡ったところで「会話履歴」を開いています。一覧から送った指示の位置へ戻れます。","width":480,"height":270,"size":"content","page":"guide-screen","section":"terminal","scene":"会話履歴のターンチップと送った命令の一覧","source":"assets-src/shots/full-14_turnchip.png","sourceWidth":3840,"sourceHeight":2160,"crop":{"x":616,"y":160,"width":480,"height":270},"sourceSha256":"dae8aef091c2c1464a0ff0b790c272cc9b65197427cf9ee425c7d899c06ad9e1","fileSha256":"85fbe5391e4da3847e42310cce012b637a8457094f483b5b6115f1278602217e","operation":"crop only; downscale-only display; no upscale, retouch or repaint"},"recording":{"poster":"/videos/14_turnchip.jpg","sources":[{"src":"/videos/14_turnchip.webm","type":"video/webm"},{"src":"/videos/14_turnchip.mp4","type":"video/mp4"}]}},{"title":"会話をまとめて見渡す","html":"<p>ダッシュボードでは、別のワークスペースの会話もまとめて見られます。</p><p><a href=\"/guide/agents#dashboard\">ダッシュボードの使い方</a></p>","shot":{"file":"/shots/top-08_dashboard.png","alt":"ダッシュボードの Claude Code と Codex の会話一覧","caption":"左に一覧、中央にセーブポイントと会話、右に配置図があります。下の入力欄から選んだ会話へ指示を送れます。","width":544,"height":306,"size":"wide","page":"guide-agents","section":"dashboard","scene":"セッション一覧、セーブポイント列、会話列、配置図のダッシュボード","source":"assets-src/shots/full-08_dashboard.png","sourceWidth":3840,"sourceHeight":2160,"crop":{"x":0,"y":468,"width":544,"height":306},"sourceSha256":"a318bc4ccc6e6d65dbdf8d271b1b4fdce8d5b5a801f7fea87ecba768c4de1836","fileSha256":"798b6bc19d37c59664d1567dc96179f1b555e4bffe59e92ffcfa3641d7eaa464","operation":"crop only; downscale-only display; no upscale, retouch or repaint"},"recording":{"poster":"/videos/08_dashboard.jpg","sources":[{"src":"/videos/08_dashboard.webm","type":"video/webm"},{"src":"/videos/08_dashboard.mp4","type":"video/mp4"}]}},{"title":"待っている質問に答える","html":"<p>「要回答」から返事が必要な会話を探します。Claude Code の質問には、カードから答えられます。</p><p><a href=\"/guide/agents#dashboard\">質問カードの使い方</a></p>","shot":{"file":"/shots/top-16_dashboard-question.png","alt":"Claude Code からの未回答の質問と入力欄","caption":"会話列の下に出た質問カードです。「その他 (自由入力)…」から答えられます。","width":544,"height":306,"size":"wide","page":"guide-agents","section":"dashboard","scene":"会話列の下にある質問カードと自由入力の入口","source":"assets-src/shots/full-16_dashboard-question.png","sourceWidth":3840,"sourceHeight":2160,"crop":{"x":1844,"y":1670,"width":544,"height":306},"sourceSha256":"91281445a946192f711ed994802838a5ceb83b1b2b181a82a23e88bae4d91b7d","fileSha256":"7f3763a45ebdf316f5965a7e8fef5ab0d67e08a72303b372233afb1cb055e80d","operation":"crop only; downscale-only display; no upscale, retouch or repaint"},"recording":{"poster":"/videos/16_dashboard-question.jpg","sources":[{"src":"/videos/16_dashboard-question.webm","type":"video/webm"},{"src":"/videos/16_dashboard-question.mp4","type":"video/mp4"}]}},{"title":"区切りを残して、また続ける","html":"<p>セーブポイントに、会話の要約と引き継ぎ書、復元情報をまとめます。</p><p><a href=\"/guide/agents#save\">残す方法と戻す方法</a></p>","shot":{"file":"/shots/top-07_savepoint-dialog.png","alt":"記録の見出しと「ここまでを保存」ボタン","caption":"「セーブポイントを作成」の画面です。見出しを付け、「ここまでを保存」で区切りを残します。","width":576,"height":324,"size":"wide","page":"guide-agents","section":"save","scene":"見出し入力欄と保存方法を選ぶ作成画面","source":"assets-src/shots/full-07_savepoint-dialog.png","sourceWidth":3840,"sourceHeight":2160,"crop":{"x":1632,"y":252,"width":576,"height":324},"sourceSha256":"12e2b5f8609f508d96ef85950eeba8119b73baf92fdbe1de90034d70cf50ae17","fileSha256":"20b92050bb9c40805c304b8e66dad9aa99c170bb4bb03b52e2785f7662d07c46","operation":"crop only; downscale-only display; no upscale, retouch or repaint"},"recording":{"poster":"/videos/07_savepoint-dialog.jpg","sources":[{"src":"/videos/07_savepoint-dialog.webm","type":"video/webm"},{"src":"/videos/07_savepoint-dialog.mp4","type":"video/mp4"}]}},{"title":"成果物を、その場で開く","html":"<p>出力されたファイルパスから、文書をアプリ内で開けます。HTML や Word の新しい形式は、編集にも進めます。</p><p><a href=\"/guide/screen#artifacts\">対応形式と保存方法</a></p>","shot":{"file":"/shots/top-22_artifact-tabs.png","alt":"HTML のタブと会話の隣に開いた文書","caption":"ペインバーです。PDF の形式の印と、選択中の HTML のペインが並んでいます。","width":624,"height":351,"size":"wide","page":"guide-screen","section":"artifacts","scene":"同じタブに並ぶ PDF の形式印と HTML のペイン","source":"assets-src/shots/full-22_artifact-tabs.png","sourceWidth":3840,"sourceHeight":2160,"crop":{"x":1664,"y":80,"width":624,"height":351},"sourceSha256":"19f64d7dfa4309180ae5435092c7ba04e2bf187241b521555fead8efc75b82ed","fileSha256":"202c65b98bc4b4e0a8274a4eae7a8a353ef29b58d00594a4972c2a8716286ddc","operation":"crop only; downscale-only display; no upscale, retouch or repaint"},"recording":{"poster":"/videos/22_artifact-tabs.jpg","sources":[{"src":"/videos/22_artifact-tabs.webm","type":"video/webm"},{"src":"/videos/22_artifact-tabs.mp4","type":"video/mp4"}]}},{"title":"自分の見やすい画面に","html":"<p>テーマや文字の大きさを変え、作業しやすい見た目に整えます。</p><p><a href=\"/guide/settings#appearance\">外観の設定</a></p>","shot":{"file":"/shots/top-10_settings-appearance.png","alt":"選択中の端末フォントと文字の見本","caption":"「かんたん設定」の一部です。背景の見せ方の 3 択と、おすすめの「石墨」「極夜」が見えます。","width":608,"height":342,"size":"content","page":"guide-settings","section":"appearance","scene":"背景の三択と石墨・極夜のテーマカード","source":"assets-src/shots/full-10_settings-appearance.png","sourceWidth":3840,"sourceHeight":2160,"crop":{"x":852,"y":928,"width":608,"height":342},"sourceSha256":"6adc5dcfc514c9e182a0312d8215f7a749c41df0bcc20d24b8923ecd50cae446","fileSha256":"d8e94b344b7d5597fe4e66507a3b4e5e20c808d46d0624ec21692a158f285fba","operation":"crop only; downscale-only display; no upscale, retouch or repaint"},"recording":{"poster":"/videos/10_settings-appearance.jpg","sources":[{"src":"/videos/10_settings-appearance.webm","type":"video/webm"},{"src":"/videos/10_settings-appearance.mp4","type":"video/mp4"}]}}]}]]}],"$L12","$L13","$L14","$L15","$L16"]}]
